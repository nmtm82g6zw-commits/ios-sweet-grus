+++ b/bsd/dev/sweet_usb.c
@@ -43,6 +43,19 @@ extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 /* osfmk/arm/machine_routines.h declares these only for PEXPERT/MACH_KERNEL_PRIVATE */
 extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, uint32_t flags);
 extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+/*
+ * io_map returns base + (phys & PAGE_MASK) for a physical address that is
+ * not 16 KiB aligned, but ml_io_unmap hands its range straight to
+ * pmap_remove, which panics on an unaligned range (0114: the SMEM
+ * apps<->adsp partition at +0x1cf000). Unmap the whole pages.
+ */
+static void
+sweet_io_unmap(vm_offset_t va, vm_size_t size)
+{
+	vm_offset_t start = va & ~(vm_offset_t)PAGE_MASK;
+	vm_offset_t end = (va + size + PAGE_MASK) & ~(vm_offset_t)PAGE_MASK;
+	ml_io_unmap(start, end - start);
+}
