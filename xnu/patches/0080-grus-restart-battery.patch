 {
+#if defined(SWEET_BOARD_GRUS)
+	/*
+	 * PM660 (SID 0), registers as Linux qpnp-fg-gen3 / smb-reg.h (grus-p-oss):
+	 * FG BATT_SOC 0x4000: MONOTONIC_SOC 0x4009 + shadow copy 0x400a (0..255,
+	 * the FG's own learned SOC, read until both match); BATT_INFO 0x4100:
+	 * VBATT 0x41a0 (122.07 uV/LSB), IBATT 0x41a2 (signed, 488.281 uA/LSB,
+	 * positive = discharging). SMB2 charger: BATTERY_CHARGER_STATUS_1 0x1006
+	 * bits 2:0 (0 trickle .. 4 taper charging, 5 terminate, 6 inhibit,
+	 * 7 disable), USBIN INT_RT_STS 0x1310 bit 4 (plugged), POWER_PATH_STATUS
+	 * 0x160b (bit 0 valid input, bit 4 use USBIN, bit 6 USBIN suspended).
+	 * Read-only: nothing is written to the PMIC.
+	 */
+	uint8_t soc0 = 0, soc1 = 1, gusb = 0, gpath = 0, gcharger = 0;
+	uint16_t gvolt = 0, gcurr = 0;
+	bool socValid = false;
+	for (unsigned attempt = 0; fReal && attempt < 5 && !socValid; ++attempt) {
+		if (sweet_spmi_read(0, 0x4009, &soc0) || sweet_spmi_read(0, 0x400a, &soc1)) {
+			break;
+		}
+		socValid = soc0 == soc1;
+	}
+	bool gvalid = socValid && readWord(0x41a0, &gvolt) &&
+	    !sweet_spmi_read(0, 0x1310, &gusb) &&
+	    !sweet_spmi_read(0, 0x160b, &gpath) &&
+	    !sweet_spmi_read(0, 0x1006, &gcharger);
+	unsigned gmv = gvalid ? (unsigned)(((uint64_t)gvolt * 122070u) / 1000000u) : 0;
+	gvalid = gvalid && gmv >= 2800 && gmv <= 4600;
+	if (!gvalid) {
+		publish(100, 4200, 0, true, true, false, true, false, false);
+		return;
+	}
+	unsigned gpercent = ((unsigned)soc0 * 100u + 127u) / 255u;
+	if (gpercent < 1) {
+		gpercent = 1; /* never let a bad sample trigger an empty-battery shutdown */
+	}
+	bool gexternal = (gusb & 0x10u) != 0;
+	bool gcapable = gexternal && (gpath & 1u) && (gpath & 0x10u) && !(gpath & 0x40u);
+	unsigned gstate = gcharger & 7u;
+	bool gcharging = gcapable && gstate <= 4;
+	bool gfull = gexternal && gstate == 5;
+	int gma = 0;
+	bool gcurrentValid = readWord(0x41a2, &gcurr);
+	if (gcurrentValid) {
+		int signedRaw = (gcurr & 0x8000u) ? (int)gcurr - 65536 : (int)gcurr;
+		gma = (int)(-((int64_t)signedRaw * 488281) / 1000000);
+	}
+	publish(gfull ? 100 : gpercent, gmv, gma, gexternal, gcapable, gcharging,
+	    gfull, true, gcurrentValid);
