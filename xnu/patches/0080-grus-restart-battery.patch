+/*
+ * Restart and power off through PSCI (SYSTEM_RESET 0x84000009, SYSTEM_OFF
+ * 0x84000008), as mainline Linux does on Qualcomm SoCs; before this the
+ * platform had no PE_halt_restart, so "Restart" from iOS hung or panicked.
+ * The boot mode after a reset is decided by ABL (PMIC PON reason, set only by
+ * Android/fastboot): a plain reset boots the boot partition. Panics keep the
+ * default (no reset) so the panic text stays on the screen.
+ */
+static int
+sweet_psci_system(uint64_t function)
+{
+	register uint64_t x0 __asm__("x0") = function;
+	register uint64_t x1 __asm__("x1") = 0;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile("dsb sy\n\tsmc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14",
+	    "x15", "x16", "x17", "memory");
+	return (int)x0; /* only reached if the firmware refused */
+}
+
+int
+SweetPlatformExpert::haltRestart(unsigned int type)
+{
+	switch (type) {
+	case kPERestartCPU:
+		IOLog("SWEET: restart (PSCI SYSTEM_RESET)\n");
+		IODelay(100000);
+		return sweet_psci_system(0x84000009ULL);
+	case kPEHaltCPU:
+	case kPEUPSDelayHaltCPU:
+		IOLog("SWEET: power off (PSCI SYSTEM_OFF)\n");
+		IODelay(100000);
+		return sweet_psci_system(0x84000008ULL);
+	default:
+		return IODTPlatformExpert::haltRestart(type);
+	}
+}
