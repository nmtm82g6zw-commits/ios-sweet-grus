+/*
+ * One layer, logical rect (dx, dy, w, h) from surface pixel (sx, sy), onto
+ * the panel through fXMap/fYMap: every panel pixel takes the logical pixel
+ * it maps to (nearest neighbour).
+ */
+void
+AppleCLCD::presentScaled(SweetSurface *s, uintptr_t src, uint32_t bpe, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	if (src == 0 || bpe != 4 || s->elementWidth != 1 || s->elementHeight != 1 || s->memory == NULL) {
+		return;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w > (int32_t)fLogicalW - dx) {
+		w = (int32_t)fLogicalW - dx;
+	}
+	if (h > (int32_t)fLogicalH - dy) {
+		h = (int32_t)fLogicalH - dy;
+	}
+	if (w <= 0 || h <= 0) {
+		return;
+	}
+	uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow + (uint64_t)(sx + w) * 4;
+	if (last > s->memory->getLength()) {
+		return;
+	}
+	uint32_t px0 = 0, px1;
+	while (px0 < fWidth && fXMap[px0] < (uint32_t)dx) {
+		px0++;
+	}
+	px1 = px0;
+	while (px1 < fWidth && fXMap[px1] < (uint32_t)(dx + w)) {
+		px1++;
+	}
+	if (px0 >= px1) {
+		return;
+	}
+	const uint8_t *base = (const uint8_t *)src + s->offset;
+	for (uint32_t py = 0; py < fHeight; py++) {
+		uint32_t ly = fYMap[py];
+		if (ly < (uint32_t)dy || ly >= (uint32_t)(dy + h)) {
+			continue;
+		}
+		const uint32_t *srow = (const uint32_t *)(base + (uint64_t)(sy + (int32_t)ly - dy) * s->bytesPerRow) + sx - dx;
+		uint32_t *drow = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes);
+		for (uint32_t px = px0; px < px1; px++) {
+			drow[px] = srow[fXMap[px]];
+		}
+	}
+}
