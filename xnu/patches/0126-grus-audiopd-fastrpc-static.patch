+/*
+ * 0126: audio PD static process, like grus Android's "adsprpcd audiopd"
+ * (Xiaomi grus-p-oss drivers/char/adsprpc.c, FASTRPC_INIT_CREATE_STATIC):
+ *  1. apps SMMU: k45 showed 7 stream match groups (USB 0x740 CB2, MDP CB3,
+ *     ...) and unmatched streams fault, so the ADSP's FastRPC/audio streams
+ *     0x1800-0x180f (msm-audio-ion 0x1801, adsprpc cb9-12 0x1803-0x1806)
+ *     get an identity context bank (SCTLR.M=0), as ios-topaz does for WLAN;
+ *  2. the remote heap (adsp_region: 8 MiB, 4 MiB aligned, below 4 GiB) is
+ *     handed to VMIDs 0x16/0x25 RWX with hyp_assign (SCM MP 0x16);
+ *  3. on "fastrpcglink-apps-dsp": invoke handle 1, method 8, 3 in-buffers
+ *     {pgid, namelen 8, pageslen 1}, "audiopd", {heap pa, size}; the
+ *     argument block (rpra, list, pages, fdlist, crclist, args aligned to
+ *     128) sits in identity-mapped memory.
+ */
+#define SWEET_RHEAP_SIZE 0x800000u
+static vm_offset_t sweet_rheap_va;
+static uint64_t sweet_rheap_pa;
+static int sweet_rheap_ok;
+static uint8_t sweet_frpc_meta[0x1000] __attribute__((aligned(0x1000)));
+static uint8_t sweet_hyp_buf[0x1000] __attribute__((aligned(0x1000)));
+
+static int
+sweet_apps_smmu_identity(uint32_t sid, uint32_t mask, const char *name)
+{
+	vm_offset_t s = ml_io_map(0x15000000, 0x80000);
+	if (s == 0) {
+		return -1;
+	}
+	uint32_t cr0 = smmu_rd(s, 0x0), id0 = smmu_rd(s, 0x20), id1 = smmu_rd(s, 0x24);
+	uint32_t nsmr = id0 & 0xffu, ncb = id1 & 0xffu;
+	uint32_t psz = (id1 >> 31) ? 0x10000u : 0x1000u, npage = 1u << (((id1 >> 28) & 7u) + 1);
+	uint32_t slot = ~0u, cb = ~0u, smr, s2cr;
+	uint64_t used = 0;
+	if ((cr0 >> 3) & 1) {
+		printf("SWEET ASMMU: extended stream IDs on, identity skipped\n");
+		return -1;
+	}
+	for (uint32_t i = 0; i < nsmr && i < 128; i++) {
+		smr = smmu_rd(s, 0x800 + 4 * i);
+		s2cr = smmu_rd(s, 0xc00 + 4 * i);
+		uint32_t id = smr & 0xffffu, m = (smr >> 16) & 0x7fffu;
+		if ((smr >> 31) && ((id ^ sid) & ~(m | mask) & 0x7fffu) == 0) {
+			slot = i;
+		} else if (!(smr >> 31) && slot == ~0u) {
+			slot = i;
+		}
+		if ((smr >> 31) && ((s2cr >> 16) & 3u) == 0) {
+			used |= 1ull << (s2cr & 0x3fu);
+		}
+	}
+	for (uint32_t i = 8; i < ncb && i < 64; i++) {
+		if (!(used & (1ull << i))) {
+			cb = i;
+			break;
+		}
+	}
+	if (slot == ~0u || cb == ~0u || (npage + cb + 1) * psz > 0x80000) {
+		printf("SWEET ASMMU: no free SMR/CB for %s (slot %u cb %u)\n", name, slot, cb);
+		return -1;
+	}
+	vm_offset_t gr1 = s + psz, cbp = s + npage * psz + cb * psz;
+	smmu_wr(cbp, 0x58, 0xffffffffu);
+	smmu_wr(cbp, 0x20, 0);
+	smmu_wr(cbp, 0x24, 0);
+	smmu_wr(cbp, 0x30, 0);
+	smmu_wr(cbp, 0x10, 0);
+	smmu_wr(cbp, 0x38, 0);
+	smmu_wr(cbp, 0x3c, 0);
+	smmu_wr(gr1, 0x800 + 4 * cb, 1);             /* CBA2R VA64 */
+	smmu_wr(gr1, 4 * cb, 0x0001f000u);           /* CBAR S1 trans, S2 fault, WB */
+	smmu_wr(cbp, 0x0, 0xe0u);                    /* SCTLR: M=0, fault reporting */
+	smmu_wr(s, 0xc00 + 4 * slot, cb);            /* S2CR translate -> cb */
+	smmu_wr(s, 0x800 + 4 * slot, (1u << 31) | (mask << 16) | sid);
+	smmu_wr(s, 0x70, 0);                         /* sTLBGSYNC */
+	for (int n = 0; n < 100000 && (smmu_rd(s, 0x74) & 1u); n++) {
+		delay(1);
+	}
+	smr = smmu_rd(s, 0x800 + 4 * slot);
+	s2cr = smmu_rd(s, 0xc00 + 4 * slot);
+	int ok = (smr >> 31) && (smr & 0xffffu) == sid && ((s2cr >> 16) & 3u) == 0 && (s2cr & 0xffu) == cb;
+	printf("SWEET ASMMU: %s identity sid 0x%x mask 0x%x CB%u SMR%u: SMR 0x%08x S2CR 0x%08x SCTLR 0x%08x -> %s\n",
+	    name, sid, mask, cb, slot, smr, s2cr, smmu_rd(cbp, 0x0), ok ? "OK" : "NOT as written");
+	return ok ? 0 : -1;
+}
+
+/* SMC with arguments 3.. in a buffer (qcom_scm-smc.c, > 4 arguments). */
+static uint64_t
+sweet_smc_ext(uint32_t svc, uint32_t cmd, uint64_t arginfo, uint64_t a0, uint64_t a1, uint64_t a2, uint64_t ext_pa)
+{
+	uint64_t a6 = 0, ret = 0, fn = 0x42000000ull | (svc << 8) | cmd;
+	for (int n = 0; n < 100000; n++) {
+		register uint64_t x0 __asm__("x0") = fn;
+		register uint64_t x1 __asm__("x1") = arginfo;
+		register uint64_t x2 __asm__("x2") = a0;
+		register uint64_t x3 __asm__("x3") = a1;
+		register uint64_t x4 __asm__("x4") = a2;
+		register uint64_t x5 __asm__("x5") = ext_pa;
+		register uint64_t x6 __asm__("x6") = a6;
+		__asm__ volatile("dsb sy\n\tsmc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3),
+		    "+r"(x4), "+r"(x5), "+r"(x6) : : "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+		    "x14", "x15", "x16", "x17", "memory");
+		ret = x0;
+		if (ret != 1) {
+			break;
+		}
+		fn = 1;
+		a6 = x6;
+	}
+	return ret;
+}
+
+static void
+sweet_remote_heap(void)
+{
+	if (kmem_alloc_contig(kernel_map, &sweet_rheap_va, SWEET_RHEAP_SIZE, PAGE_MASK,
+	    (ppnum_t)atop_64(0x100000000ull) - 1, (ppnum_t)atop_64(0x400000ull) - 1,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET FRPC: no %u-byte contiguous remote heap\n", SWEET_RHEAP_SIZE);
+		return;
+	}
+	ppnum_t p0 = pmap_find_phys(kernel_pmap, (addr64_t)sweet_rheap_va);
+	ppnum_t p1 = pmap_find_phys(kernel_pmap, (addr64_t)sweet_rheap_va + SWEET_RHEAP_SIZE - PAGE_SIZE);
+	sweet_rheap_pa = ptoa_64(p0);
+	if (!p0 || ptoa_64(p1) != sweet_rheap_pa + SWEET_RHEAP_SIZE - PAGE_SIZE || (sweet_rheap_pa & 0x3fffffu) ||
+	    sweet_rheap_pa + SWEET_RHEAP_SIZE > 0x100000000ull) {
+		printf("SWEET FRPC: remote heap pa 0x%llx not usable\n", (unsigned long long)sweet_rheap_pa);
+		return;
+	}
+	FlushPoC_DcacheRegion(sweet_rheap_va, SWEET_RHEAP_SIZE);
+	/* qcom_scm_assign_mem: mem list @0, src vmids @64, dest perms @128, ext args @256 */
+	uint8_t *b = sweet_hyp_buf;
+	uint64_t bpa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)(uintptr_t)b)) + ((uintptr_t)b & PAGE_MASK);
+	bzero(b, 512);
+	uint64_t *mem = (uint64_t *)(void *)b;
+	mem[0] = sweet_rheap_pa;
+	mem[1] = SWEET_RHEAP_SIZE;
+	*(uint32_t *)(void *)(b + 64) = 3;                      /* VMID_HLOS */
+	uint32_t *d = (uint32_t *)(void *)(b + 128);
+	d[0] = 0x16; d[1] = 7;                                  /* vmid, RWX; ctx 0, ctx_size 0 */
+	d[6] = 0x25; d[7] = 7;
+	uint64_t *ext = (uint64_t *)(void *)(b + 256);
+	ext[0] = 4;                                             /* src list size */
+	ext[1] = bpa + 128;                                     /* dest list */
+	ext[2] = 48;                                            /* 2 x 24 bytes */
+	ext[3] = 0;
+	FlushPoC_DcacheRegion((vm_offset_t)b, 512);
+	uint64_t r = sweet_smc_ext(0x0c, 0x16, 0x1117, bpa, 16, bpa + 64, bpa + 256);
+	sweet_rheap_ok = (r == 0);
+	printf("SWEET FRPC: remote heap 0x%llx+0x%x hyp_assign HLOS -> 0x16/0x25 RWX: ret %lld%s\n",
+	    (unsigned long long)sweet_rheap_pa, SWEET_RHEAP_SIZE, (long long)r, r ? "" : " (assigned, apps no longer touches it)");
+}
+
+/* Build the CREATE_STATIC argument block; returns its physical address. */
+static uint64_t
+sweet_frpc_create_static_args(uint32_t pgid)
+{
+	uint8_t *m = sweet_frpc_meta;
+	uint64_t pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)(uintptr_t)m)) + ((uintptr_t)m & PAGE_MASK);
+	bzero(m, sizeof(sweet_frpc_meta));
+	/* rpra[3] @0 (16 B), list[3] @48 (8 B), pages[3] @72 (16 B), fdlist @120, crclist @248, meta 504 */
+	static const uint32_t off[3] = { 512, 640, 768 }, len[3] = { 12, 8, 16 };
+	uint32_t inbuf[3] = { pgid, 8, 1 };
+	bcopy(inbuf, m + 512, 12);
+	bcopy("audiopd", m + 640, 8);
+	uint64_t pg[2] = { sweet_rheap_pa, SWEET_RHEAP_SIZE };
+	bcopy(pg, m + 768, 16);
+	for (unsigned i = 0; i < 3; i++) {
+		uint64_t a = pa + off[i];
+		uint64_t *rp = (uint64_t *)(void *)(m + 16 * i);
+		rp[0] = a;                                      /* pv: low bits = offset in page */
+		rp[1] = len[i];
+		int32_t *l = (int32_t *)(void *)(m + 48 + 8 * i);
+		l[0] = 1;
+		l[1] = (int32_t)i;
+		uint64_t *p = (uint64_t *)(void *)(m + 72 + 16 * i);
+		p[0] = a & ~0xfffull;
+		p[1] = 0x1000;
+	}
+	FlushPoC_DcacheRegion((vm_offset_t)m, sizeof(sweet_frpc_meta));
+	return pa;
+}
