+/*
+ * Remote processors, step 0 (read-only, sweetsmem=0 disables): what the
+ * Qualcomm shared memory says before anything boots the ADSP/modem.
+ * grus stock DTB: qcom,smem@86000000 size 0x200000 (qcom,mpu-enabled).
+ * Linux drivers/soc/qcom/smem.c layout: global header (proc_comm[4],
+ * version[32], initialized, available, reserved, toc[] of 16-byte
+ * entries), version[7] >> 16 = 11 (global partition) or 12 (global heap);
+ * partition table "$TOC" in the last 4 KiB (48-byte entries: offset, size,
+ * flags, host0, host1, cacheline). Partitions are only listed, never read
+ * (the MPU may fence remote-only ones). Item 469 = image version table
+ * (32 x 128-byte entries: 0 boot, 1 TZ, 3 RPM, 10 apps, 11 MPSS,
+ * 12 ADSP, 13 CNSS/WLAN, 14 video), printed from the global heap.
+ */
+static void
+sweet_smem_probe(void)
+{
+#if defined(SWEET_BOARD_GRUS)
+	int on = 1;
+	PE_parse_boot_argn("sweetsmem", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	const uint32_t size = 0x200000;
+	vm_offset_t m = ml_io_map(0x86000000, size);
+	if (m == 0) {
+		return;
+	}
+	uint32_t ver7 = usb_rd(m, 64 + 7 * 4);
+	uint32_t init = usb_rd(m, 64 + 128), avail = usb_rd(m, 64 + 132);
+	printf("SWEET SMEM: version[7] 0x%08x (%s) initialized %u available 0x%x\n", ver7,
+	    (ver7 >> 16) == 12 ? "global heap" : ((ver7 >> 16) == 11 ? "global partition" : "unknown"),
+	    init, avail);
+	vm_offset_t pt = m + size - 0x1000;
+	if (usb_rd(pt, 0) == 0x434f5424u) {    /* "$TOC" */
+		uint32_t n = usb_rd(pt, 8);
+		printf("SWEET SMEM: partition table v%u, %u entries\n", usb_rd(pt, 4), n);
+		for (uint32_t i = 0; i < n && i < 32; i++) {
+			vm_offset_t e = pt + 32 + i * 48;
+			uint32_t hosts = usb_rd(e, 12);
+			printf("SWEET SMEM:  part %u off 0x%x size 0x%x flags 0x%x hosts %u<->%u cacheline %u\n",
+			    i, usb_rd(e, 0), usb_rd(e, 4), usb_rd(e, 8), hosts & 0xffffu, hosts >> 16,
+			    usb_rd(e, 16));
+		}
+	} else {
+		printf("SWEET SMEM: no partition table (0x%08x)\n", usb_rd(pt, 0));
+	}
+	if ((ver7 >> 16) == 12) {
+		vm_offset_t toc = m + 64 + 128 + 12 + 469 * 16;
+		uint32_t alloc = usb_rd(toc, 0), off = usb_rd(toc, 4), sz = usb_rd(toc, 8);
+		if (alloc == 1 && off + sz <= size && sz >= 128) {
+			static const char *const names[16] = { "boot", "tz", "", "rpm", "", "", "", "",
+				"", "", "apps", "mpss", "adsp", "cnss", "video", "" };
+			for (uint32_t i = 0; i < 32 && (i + 1) * 128 <= sz; i++) {
+				char str[80];
+				uint32_t k;
+				for (k = 0; k < sizeof(str) - 1; k++) {
+					uint32_t w = usb_rd(m + off + i * 128, k & ~3u);
+					char c = (char)(w >> (8 * (k & 3u)));
+					if (c == 0) {
+						break;
+					}
+					str[k] = (c >= 32 && c < 127) ? c : '.';
+				}
+				str[k] = 0;
+				if (k > 0) {
+					printf("SWEET SMEM: image %u (%s): %s\n", i, i < 16 ? names[i] : "", str);
+				}
+			}
+		} else {
+			printf("SWEET SMEM: no image version table (alloc %u off 0x%x size 0x%x)\n", alloc, off, sz);
+		}
+	}
+#endif
+}
