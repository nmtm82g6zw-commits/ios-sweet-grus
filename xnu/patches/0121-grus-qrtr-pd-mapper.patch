+/* 0121: per-channel GLINK state and remote-intent pool. */
+struct sweet_glch {
+	uint32_t lcid, rcid, npool, extra;
+	int acked, hello;
+	struct { uint32_t iid, size; int busy; } pool[8];
+};
+
+/* TX_DATA on a free remote intent: {9|lcid, riid, chunk, left=0} + data. */
+static int
+sweet_glch_send(struct sweet_glch *c, const uint32_t *data, uint32_t bytes)
+{
+	uint32_t w[4 + 64];
+	unsigned k;
+	if (!c->acked || bytes > 256) {
+		return -1;
+	}
+	for (k = 0; k < c->npool && (c->pool[k].busy || c->pool[k].size < bytes); k++) {
+	}
+	if (k == c->npool) {
+		return -1;
+	}
+	w[0] = 9u | (c->lcid << 16);
+	w[1] = c->pool[k].iid;
+	w[2] = bytes;
+	w[3] = 0;
+	uint32_t nw = (bytes + 3) / 4;
+	for (uint32_t j = 0; j < nw; j++) {
+		w[4 + j] = data[j];
+	}
+	c->pool[k].busy = 1;
+	sweet_glink_tx(w, (4 + nw + 1u) & ~1u);
+	return 0;
+}
+
+#define QRTR_CTRL_PORT   0xfffffffeu
+#define SWEET_LOC_PORT   0x4000u
+
+/* QRTR v1 packet from node 1. */
+static int
+sweet_qrtr_tx(struct sweet_glch *c, uint32_t type, uint32_t sport, uint32_t dnode, uint32_t dport,
+    const void *payload, uint32_t len)
+{
+	uint32_t w[8 + 48];
+	if (len > 48 * 4) {
+		return -1;
+	}
+	w[0] = 1;
+	w[1] = type;
+	w[2] = 1;
+	w[3] = sport;
+	w[4] = 0;
+	w[5] = len;
+	w[6] = dnode;
+	w[7] = dport;
+	bzero(&w[8], (len + 3) & ~3u);
+	bcopy(payload, &w[8], len);
+	int r = sweet_glch_send(c, w, 32 + ((len + 3) & ~3u));
+	if (r) {
+		printf("SWEET QRTR: tx type %u dropped (no remote intent)\n", type);
+	}
+	return r;
+}
+
+static uint32_t
+sweet_put_str(uint8_t *b, const char *s)
+{
+	uint32_t n = (uint32_t)strlen(s);
+	b[0] = (uint8_t)n;
+	bcopy(s, b + 1, n);
+	return n + 1;
+}
+
+/* pd-mapper (qcom_pd_mapper.c, qcom,sdm670): GET_DOMAIN_LIST response. */
+static uint32_t
+sweet_pdm_domain_list(const char *service, uint32_t offset, uint8_t *b, uint32_t txn)
+{
+	static const struct { const char *svc, *dom; uint32_t inst; } db[] = {
+		{ "tms/servreg", "msm/adsp/audio_pd", 74 },
+		{ "tms/servreg", "msm/adsp/root_pd", 74 },
+		{ "tms/servreg", "msm/cdsp/root_pd", 76 },
+		{ "tms/servreg", "msm/modem/root_pd", 180 },
+		{ "tms/servreg", "msm/modem/wlan_pd", 180 },
+		{ "avs/audio", "msm/adsp/audio_pd", 74 },
+		{ "kernel/elf_loader", "msm/modem/wlan_pd", 180 },
+		{ "wlan/fw", "msm/modem/wlan_pd", 180 },
+	};
+	uint32_t p = 7, total = 0, listed = 0, lp;
+	b[p++] = 0x02; b[p++] = 4; b[p++] = 0;           /* resp: result 0, error 0 */
+	b[p++] = 0; b[p++] = 0; b[p++] = 0; b[p++] = 0;
+	uint32_t tp = p;
+	p += 5;                                            /* 0x10 total_domains (u16) later */
+	b[p++] = 0x11; b[p++] = 2; b[p++] = 0; b[p++] = 1; b[p++] = 0;   /* db_rev_count 1 */
+	b[p++] = 0x12;
+	lp = p;
+	p += 2;
+	uint32_t vstart = p;
+	b[p++] = 0;                                        /* list length (u8) */
+	for (unsigned i = 0; i < sizeof(db) / sizeof(db[0]); i++) {
+		if (strcmp(db[i].svc, service) != 0) {
+			continue;
+		}
+		if (total++ < offset) {
+			continue;
+		}
+		p += sweet_put_str(b + p, db[i].dom);
+		bcopy(&db[i].inst, b + p, 4);
+		p += 4;
+		b[p++] = 0;                                    /* service_data_valid */
+		bzero(b + p, 4);
+		p += 4;
+		listed++;
+	}
+	b[vstart] = (uint8_t)listed;
+	uint32_t vlen = p - vstart;
+	b[lp] = (uint8_t)vlen;
+	b[lp + 1] = (uint8_t)(vlen >> 8);
+	b[tp] = 0x10; b[tp + 1] = 2; b[tp + 2] = 0;
+	b[tp + 3] = (uint8_t)total; b[tp + 4] = (uint8_t)(total >> 8);
+	/* QMI header: response, txn, msg 0x21, len */
+	b[0] = 2;
+	b[1] = (uint8_t)txn; b[2] = (uint8_t)(txn >> 8);
+	b[3] = 0x21; b[4] = 0;
+	b[5] = (uint8_t)(p - 7); b[6] = (uint8_t)((p - 7) >> 8);
+	printf("SWEET PDM: \"%s\" offset %u -> %u of %u domains\n", service, offset, listed, total);
+	return p;
+}
+
+static void
+sweet_qrtr_rx(struct sweet_glch *c, uint32_t d, uint32_t chunk, uint32_t *adsp_node, int *served)
+{
+	uint8_t pkt[512];
+	uint32_t n = chunk < sizeof(pkt) ? chunk : sizeof(pkt);
+	for (uint32_t k = 0; k < n; k += 4) {
+		uint32_t w = sweet_glink_rx32(d + k);
+		bcopy(&w, pkt + k, (n - k) < 4 ? (n - k) : 4);
+	}
+	uint32_t type, snode, sport, size, dport, confirm = 0, hl;
+	if (pkt[0] == 1 && n >= 32) {
+		uint32_t *h = (uint32_t *)(void *)pkt;
+		type = h[1]; snode = h[2]; sport = h[3]; confirm = h[4]; size = h[5]; dport = h[7];
+		hl = 32;
+	} else if (pkt[0] == 3 && n >= 16) {
+		type = pkt[1];
+		confirm = pkt[2] & 1u;
+		size = (uint32_t)pkt[4] | ((uint32_t)pkt[5] << 8) | ((uint32_t)pkt[6] << 16) | ((uint32_t)pkt[7] << 24);
+		snode = (uint32_t)pkt[8] | ((uint32_t)pkt[9] << 8);
+		sport = (uint32_t)pkt[10] | ((uint32_t)pkt[11] << 8);
+		dport = (uint32_t)pkt[14] | ((uint32_t)pkt[15] << 8);
+		if (sport == 0xffffu) {
+			sport = QRTR_CTRL_PORT;
+		}
+		if (dport == 0xffffu) {
+			dport = QRTR_CTRL_PORT;
+		}
+		hl = 16 + pkt[3];
+	} else {
+		printf("SWEET QRTR: unknown header version %u (chunk %u)\n", pkt[0], chunk);
+		return;
+	}
+	if (hl + size > n) {
+		printf("SWEET QRTR: short packet (hdr %u size %u chunk %u)\n", hl, size, n);
+		return;
+	}
+	const uint8_t *pl = pkt + hl;
+	uint32_t pw[5] = { 0 };
+	bcopy(pl, pw, size < 20 ? size : 20);
+	*adsp_node = snode;
+	switch (type) {
+	case 2: {                                  /* HELLO */
+		printf("SWEET QRTR: HELLO from node %u (v%u)%s\n", snode, pkt[0], c->hello ? ", already answered" : "");
+		if (c->hello++) {
+			break;
+		}
+		uint32_t hello[5] = { 2, 0, 0, 0, 0 };
+		sweet_qrtr_tx(c, 2, QRTR_CTRL_PORT, snode, QRTR_CTRL_PORT, hello, 20);
+		uint32_t ns[5] = { 4, 0x40, 0x101, 1, SWEET_LOC_PORT };   /* NEW_SERVER locator */
+		sweet_qrtr_tx(c, 4, QRTR_CTRL_PORT, snode, QRTR_CTRL_PORT, ns, 20);
+		printf("SWEET QRTR: HELLO + NEW_SERVER(service 0x40 ver 0x101 node 1 port 0x%x) sent\n", SWEET_LOC_PORT);
+		break;
+	}
+	case 4:                                    /* NEW_SERVER */
+		printf("SWEET QRTR: NEW_SERVER service 0x%x instance 0x%x node %u port 0x%x%s\n",
+		    pw[1], pw[2], pw[3], pw[4], pw[1] == 0x42 ? " (servreg notifier)" : "");
+		break;
+	case 5:
+		printf("SWEET QRTR: DEL_SERVER service 0x%x instance 0x%x\n", pw[1], pw[2]);
+		break;
+	case 10:
+		printf("SWEET QRTR: NEW_LOOKUP service 0x%x instance 0x%x from node %u\n", pw[1], pw[2], snode);
+		break;
+	case 7:
+	case 9:
+		break;
+	case 1: {                                  /* DATA: QMI */
+		if (size < 7) {
+			break;
+		}
+		uint32_t qtype = pl[0], txn = pl[1] | (pl[2] << 8), msg = pl[3] | (pl[4] << 8);
+		uint32_t qlen = pl[5] | (pl[6] << 8);
+		printf("SWEET QMI: from %u:0x%x to port 0x%x type %u txn %u msg 0x%x len %u\n",
+		    snode, sport, dport, qtype, txn, msg, qlen);
+		if (dport == SWEET_LOC_PORT && qtype == 0) {
+			char svc[66] = { 0 };
+			uint32_t off = 0;
+			for (uint32_t q = 7; q + 3 <= 7 + qlen && q + 3 <= size;) {
+				uint32_t tt = pl[q], tl = pl[q + 1] | (pl[q + 2] << 8);
+				if (q + 3 + tl > size) {
+					break;
+				}
+				if (tt == 0x01) {
+					uint32_t sl = tl < 65 ? tl : 65;
+					bcopy(pl + q + 3, svc, sl);
+					svc[sl] = 0;
+				} else if (tt == 0x10 && tl == 4) {
+					bcopy(pl + q + 3, &off, 4);
+				}
+				q += 3 + tl;
+			}
+			uint8_t rsp[200];
+			uint32_t rl;
+			if (msg == 0x21) {
+				printf("SWEET PDM: GET_DOMAIN_LIST \"%s\"\n", svc);
+				rl = sweet_pdm_domain_list(svc, off, rsp, txn);
+				(*served)++;
+			} else {
+				/* PFR or anything else: plain success response */
+				printf("SWEET PDM: request 0x%x (%s) acknowledged\n", msg, msg == 0x24 ? "PFR" : "?");
+				rsp[0] = 2; rsp[1] = (uint8_t)txn; rsp[2] = (uint8_t)(txn >> 8);
+				rsp[3] = (uint8_t)msg; rsp[4] = (uint8_t)(msg >> 8); rsp[5] = 7; rsp[6] = 0;
+				rsp[7] = 2; rsp[8] = 4; rsp[9] = 0; rsp[10] = rsp[11] = rsp[12] = rsp[13] = 0;
+				rl = 14;
+			}
+			sweet_qrtr_tx(c, 1, SWEET_LOC_PORT, snode, sport, rsp, rl);
+		}
+		break;
+	}
+	default:
+		printf("SWEET QRTR: type %u from %u:0x%x size %u\n", type, snode, sport, size);
+		break;
+	}
+	if (confirm) {
+		uint32_t rt[5] = { 7, 1, dport, 0, 0 };   /* RESUME_TX client = our node/port */
+		sweet_qrtr_tx(c, 7, dport, snode, sport, rt, 20);
+	}
+}
