+			uint32_t w[10];
+			w[0] = 9u | (lcid << 16);      /* TX_DATA, lcid */
+			w[1] = riid;
+			w[2] = 20;                     /* chunk */
+			w[3] = 0;                      /* left */
+			w[4] = 0x150u | (20u << 16);   /* APR hdr_field (SEQ_CMD, 5 words), pkt_size */
+			w[5] = 3u | (5u << 8);         /* src svc core, domain apps, port 0 */
+			w[6] = 3u | (4u << 8);         /* dest svc core, domain adsp, port 0 */
+			w[7] = 0x5eed0000u | step;     /* token */
+			w[8] = ops[step];
+			w[9] = 0;                      /* pad to 8 */
+			if (rsize >= 20) {
+				sweet_glink_tx(w, 10);
+				printf("SWEET APR: tx opcode 0x%x on riid %u\n", ops[step], riid);
+				ravail = 0;
+				step++;
+			}
+		}
 		uint32_t head = GL_DESC(3), tail = GL_DESC(2);
 		if (head == tail) {
 			ud_sleep_ms(10);
@@ -1835,16 +1883,73 @@ sweet_glink_adsp(void)
 			printf("SWEET GLINK: rx OPEN rcid %u \"%s\"\n", p1, name);
