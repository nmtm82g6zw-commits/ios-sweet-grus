+						printf("SWEET APR:   service 0x%x version 0x%x\n",
+						    sweet_glink_rx32(d + 28 + 8 * k), sweet_glink_rx32(d + 32 + 8 * k));
+					}
+				}
+				uint32_t done[2] = { 14u | (lcid << 16), p2 };      /* RX_DONE_W_REUSE liid */
+				GL_DESC(2) = (tail + adv) % sweet_gl.rxlen;
+				sweet_glink_tx(done, 2);
+				continue;
+			}
 			printf("SWEET GLINK: rx DATA cid %u chunk %u\n", p1, chunk);
 			break;
 		}
