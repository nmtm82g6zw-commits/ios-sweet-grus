+				uint32_t d = tail + 16;
+				uint32_t opc = sweet_glink_rx32(d + 16), tok = sweet_glink_rx32(d + 12);
+				uint32_t a0 = chunk >= 24 ? sweet_glink_rx32(d + 20) : 0;
+				uint32_t a1 = chunk >= 28 ? sweet_glink_rx32(d + 24) : 0;
+				uint32_t a2 = chunk >= 32 ? sweet_glink_rx32(d + 28) : 0;
+				uint32_t a3 = chunk >= 36 ? sweet_glink_rx32(d + 32) : 0;
+				printf("SWEET APR: rx opcode 0x%x token 0x%x len %u: 0x%x 0x%x 0x%x 0x%x%s\n", opc, tok,
+				    chunk, a0, a1, a2, a3,
+				    opc == 0x0001290du ? (a0 == 1 ? " (ADSP READY)" : " (adsp not ready)") :
+				    (opc == 0x000110e8u ? " (basic response: opcode, status)" : ""));
+				if (opc == 0x00012906u) {   /* versions: build id, count, {svc, ver}... */
+					uint32_t n = a1 < 24 ? a1 : 24;
