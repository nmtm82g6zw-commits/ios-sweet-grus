+			    sweet_glink_rx32(tail + 8), sweet_glink_rx32(tail + 12));
 			break;
 		case 9:
 		case 12: {                         /* TX_DATA(_CONT): chunk, left, data */
 			uint32_t chunk = sweet_glink_rx32(tail + 8);
 			adv = (16 + chunk + 7u) & ~7u;
