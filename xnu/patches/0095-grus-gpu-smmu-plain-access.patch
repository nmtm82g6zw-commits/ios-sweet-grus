+/*
+ * The GPU SMMU's global space is trapped by Qualcomm's hypervisor and
+ * emulated (0094 hung on S2CR0: clang turned the loop read into a
+ * post-indexed "ldr w9, [x28], #4", which has no valid syndrome (ISV=0),
+ * so the hypervisor cannot emulate it). Every SMMU access goes through a
+ * plain single-register ldr/str with no writeback.
+ */
+static inline uint32_t
+smmu_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v;
+	__asm__ volatile ("ldr %w0, [%1]" : "=r"(v) : "r"(base + off) : "memory");
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+smmu_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("str %w0, [%1]" :: "r"(v), "r"(base + off) : "memory");
+}
+
 /*
  * Adreno 616 bring-up, step 4a: read-only dump of the GPU SMMU (kgsl_smmu,
  * ARM SMMUv2 at 0x05040000, 4 KiB register pages; grus sdm670-gpu.dtsi
@@ -522,15 +544,15 @@ sweet_gpu_smmu_dump(void)
 	if (s == 0) {
 		return;
 	}
-	uint32_t idr1 = usb_rd(s, 0x24);
-	unsigned nsmr = usb_rd(s, 0x20) & 0xffu, ncb = idr1 & 0xffu;
+	uint32_t idr1 = smmu_rd(s, 0x24);
+	unsigned nsmr = smmu_rd(s, 0x20) & 0xffu, ncb = idr1 & 0xffu;
 	unsigned gpages = 1u << (((idr1 >> 28) & 7u) + 1);
 	printf("SWEET SMMU: sCR0 0x%08x IDR2 0x%08x sGFSR 0x%08x sGFSYNR0 0x%08x sGFAR 0x%08x%08x; %u SMR, %u CB, CB base +0x%x\n",
-	    usb_rd(s, 0x0), usb_rd(s, 0x28), usb_rd(s, 0x48), usb_rd(s, 0x50),
-	    usb_rd(s, 0x44), usb_rd(s, 0x40), nsmr, ncb, gpages * 0x1000u);
+	    smmu_rd(s, 0x0), smmu_rd(s, 0x28), smmu_rd(s, 0x48), smmu_rd(s, 0x50),
+	    smmu_rd(s, 0x44), smmu_rd(s, 0x40), nsmr, ncb, gpages * 0x1000u);
 	for (unsigned i = 0; i < nsmr && i < 16; i++) {
-		printf("SWEET SMMU: SMR%u 0x%08x S2CR%u 0x%08x\n", i, usb_rd(s, 0x800 + 4 * i),
-		    i, usb_rd(s, 0xc00 + 4 * i));
+		printf("SWEET SMMU: SMR%u 0x%08x S2CR%u 0x%08x\n", i, smmu_rd(s, 0x800 + 4 * i),
+		    i, smmu_rd(s, 0xc00 + 4 * i));
 	}
 	for (unsigned i = 0; i < ncb && i < 16; i++) {
 		vm_offset_t cb = s + gpages * 0x1000u + i * 0x1000u;
@@ -538,9 +560,9 @@ sweet_gpu_smmu_dump(void)
 			break;
 		}
