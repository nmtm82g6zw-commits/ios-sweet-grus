diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 19e97aa..73d8fdf 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -927,30 +927,61 @@ sweet_gmu_oob(vm_offset_t gmu, unsigned set, unsigned ack, const char *name)
 #define ZAP_MEM_SIZE 0x2000u
 static uint8_t sweet_zap_meta[0x2000] __attribute__((aligned(0x1000)));
 
+/*
+ * One SMC with the Qualcomm "A6 quirk" (Linux qcom_scm-smc.c
+ * __scm_smc_do_quirk): while TZ answers QCOM_SCM_INTERRUPTED (1) the call
+ * is resumed with x0 = 1, the same x1-x5 and the x6 (session) TZ returned.
+ * 0101's PAS_INIT_IMAGE came back with 1: TZ was interrupted while
+ * verifying the image and expected this resume.
+ */
 static uint64_t
-sweet_scm_svc(uint32_t svc, uint32_t cmd, uint32_t arginfo, uint64_t a0, uint64_t a1, uint64_t a2, uint64_t *r1)
+sweet_smc_quirk(uint64_t fn, uint64_t arginfo, uint64_t a0, uint64_t a1, uint64_t a2, uint64_t *r1, unsigned *resumes)
 {
-	uint64_t ret = 0, res1 = 0;
-	for (int tries = 0; tries < 50; tries++) {
-		register uint64_t x0 __asm__("x0") = 0x42000000ull | (svc << 8) | cmd;   /* STD, SMC64, SIP */
+	uint64_t a6 = 0, ret;
+	unsigned n = 0;
+	for (;;) {
+		register uint64_t x0 __asm__("x0") = fn;
 		register uint64_t x1 __asm__("x1") = arginfo;
 		register uint64_t x2 __asm__("x2") = a0;
 		register uint64_t x3 __asm__("x3") = a1;
 		register uint64_t x4 __asm__("x4") = a2;
 		register uint64_t x5 __asm__("x5") = 0;
-		register uint64_t x6 __asm__("x6") = 0;
+		register uint64_t x6 __asm__("x6") = a6;
 		__asm__ volatile("dsb sy\n\tsmc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3),
 		    "+r"(x4), "+r"(x5), "+r"(x6) : : "x7", "x8", "x9", "x10", "x11", "x12", "x13",
 		    "x14", "x15", "x16", "x17", "memory");
 		ret = x0;
-		res1 = x1;
+		if (r1) {
+			*r1 = x1;
+		}
+		if (ret != 1 || n >= 100000) {
+			break;
+		}
+		fn = 1;                                /* QCOM_SCM_INTERRUPTED: resume */
+		a6 = x6;
+		n++;
+	}
+	if (resumes) {
+		*resumes = n;
+	}
+	return ret;
+}
+
+static uint64_t
+sweet_scm_svc(uint32_t svc, uint32_t cmd, uint32_t arginfo, uint64_t a0, uint64_t a1, uint64_t a2, uint64_t *r1)
+{
+	uint64_t ret = 0;
+	unsigned resumes = 0, total = 0;
+	for (int tries = 0; tries < 50; tries++) {
+		ret = sweet_smc_quirk(0x42000000ull | (svc << 8) | cmd, arginfo, a0, a1, a2, r1, &resumes);
+		total += resumes;
 		if ((int64_t)ret != -12) {             /* QCOM_SCM_V2_EBUSY: retry */
 			break;
 		}
 		delay(1000);
 	}
-	if (r1) {
-		*r1 = res1;
+	if (total) {
+		printf("SWEET ZAP: SCM %u/%u resumed %u times\n", svc, cmd, total);
 	}
 	return ret;
 }
