+/*
+ * 0096 (sweetgpu=3) reset the phone during boot with no log left (the
+ * firmware rebooted into the installed kernel, which overwrote the
+ * persistent log). From 0097 the GMU steps run 45 s after boot, when the
+ * persistent log has the boot and the live USB log (sweetusb=2, UDP 5140,
+ * sent every 100 ms) is up; each step is printed and given 300 ms to leave
+ * before the next one. sweetgpustop=N stops early: 1 = SMMU programmed but
+ * not handed to the GMU (GMU boots as in 0093), 2 = queue table and log
+ * handed over and GMU booted, no HFI_CTRL_INIT; 0 (default) = everything.
+ */
+static void
+sweet_gpu_late_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	ud_sleep_ms(45000);
+	printf("SWEET GPU: late GMU bring-up starting\n");
+	ud_sleep_ms(300);
+	sweet_gpu_gmu_boot(sweet_gpu_late.gcc, sweet_gpu_late.cc, sweet_gpu_late.gmu);
+	printf("SWEET GPU: late GMU bring-up finished\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
