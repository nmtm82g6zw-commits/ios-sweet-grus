-	GW(0x5100, 0);                         /* PWR_COL_CP_MSG: no log buffer */
+	/* PWR_COL_CP_MSG: GMU log buffer (16 KiB = 4 pages - 1) */
+	GW(0x5100, hfi ? (SWEET_GMU_IOVA + 0x9000) | 3u : 0);
 	GW(0x4c0f, 1); GW(0x4c00, 1); GW(0x4c01, 1);   /* SYS_BUS/ICACHE/DCACHE_CONFIG */
 	GW(0x50c0, 0x9c40400u);                /* PWR_COL_INTER_FRAME_CTRL */
 	GW(0x50e8, GR(0x50e8) | 1u | (1u << 4) | (1u << 8) | (1u << 9) | (1u << 10) | (1u << 11));
@@ -720,6 +903,9 @@ sweet_gpu_gmu_boot(vm_offset_t gcc, vm_offset_t cc, vm_offset_t gmu)
 	if ((res & mask) != want) {
 		GW(0x5000, 1);                     /* stop the CM3 again */
 	}
+	if (hfi && (res & mask) == want) {
+		sweet_hfi_start(gmu);
+	}
 	sweet_gpu_smmu_dump();
 #undef PW
 #undef G
