+
+static inline uint32_t
+sweet_mdp_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(sweet_mdp + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+sweet_mdp_wr(uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dsb oshst" ::: "memory");     /* pixels before the kick */
+	*(volatile uint32_t *)(sweet_mdp + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
