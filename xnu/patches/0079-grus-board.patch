+/* sdm670-sde.dtsi offsets from mdss_mdp@ae00000 (SDE v4 register layout). */
+#define SWEET_MDP_PA            0x0ae00000ULL
+#define SWEET_MDP_SIZE          0x80000
+#define SWEET_MDP_CTLS          5
+#define SWEET_MDP_CTL(n)        (0x2000u + 0x200u * (n))
+#define SWEET_CTL_TOP           0x014u  /* bit 17: command mode, bits 7:4 intf */
+#define SWEET_CTL_START         0x01cu
+#define SWEET_MDP_PPS           4
+#define SWEET_MDP_PP(n)         (0x71000u + 0x800u * (n))
+#define SWEET_PP_TEAR_CHECK_EN  0x000u
+#define SWEET_PP_AUTOREFRESH    0x030u  /* bit 31 enable, low bits frame count */
