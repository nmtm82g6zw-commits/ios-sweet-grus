+static void
+sweet_mdp_kick(void)
+{
+	if (sweet_mdp_kick_ctl >= 0) {
+		sweet_mdp_wr(SWEET_MDP_CTL(sweet_mdp_kick_ctl) + SWEET_CTL_START, 1);
+	}
