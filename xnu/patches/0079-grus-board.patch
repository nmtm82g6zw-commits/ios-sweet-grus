+		uint32_t top = sweet_mdp_rd(SWEET_MDP_CTL(n) + SWEET_CTL_TOP);
+		IOLog("SWEET FB: MDP CTL%u TOP %#x\n", n, top);
+		if (cmd_ctl < 0 && (top & (1u << 17)) && (top & 0xf0u)) {
