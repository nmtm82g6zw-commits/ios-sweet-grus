+/*
+ * Remote processors, step 2: GLINK over SMEM with the ADSP (Linux
+ * qcom_glink_smem.c + qcom_glink_native.c). 0115: after the ADSP booted,
+ * the apps<->adsp partition held items 478 (xprt descriptor, 32 bytes:
+ * tx tail/head, rx tail/head from our side), 480 (FIFO_1, its TX = our
+ * RX) and others. We allocate 479 (FIFO_0, our TX, 16 KiB) under the SMEM
+ * hardware spinlock (sdm670 hwlocks <&tcsr_mutex 3>: TCSR mutex 0x1f40000
+ * + 3 * 0x1000, owner 1 = apps, as qcom_hwspinlock.c), zero our tail/head,
+ * send VERSION (v1, feature INTENT_REUSE), ring the ADSP (APCS IPC
+ * 0x1799000c bit 24, grus glink-smem-native-xprt-adsp qcom,irq-mask
+ * 0x1000000) and poll the RX FIFO for 10 s: VERSION/VERSION_ACK answered,
+ * OPEN logged with the channel name (not acked yet), others skipped.
+ */
+struct sweet_smem_item {
+	vm_offset_t data;
+	uint32_t size;
+};
+
+static int
+sweet_smem_find(vm_offset_t m, uint32_t part_size, unsigned item, struct sweet_smem_item *out)
+{
+	uint32_t free_unc = usb_rd(m, 12), p = 32;
+	for (int n = 0; n < 64 && p + 16 <= free_unc && free_unc <= part_size; n++) {
+		uint32_t h0 = usb_rd(m, p), size = usb_rd(m, p + 4), pad = usb_rd(m, p + 8);
+		if ((h0 & 0xffffu) != 0xa5a5u) {
+			return -1;
+		}
+		if ((h0 >> 16) == item) {
+			out->data = m + p + 16 + (pad >> 16);
+			out->size = size - (pad & 0xffffu);
+			return 0;
+		}
+		p += 16 + (pad >> 16) + size;
+	}
+	return -1;
+}
+
+/* qcom_smem_alloc_private, under the SMEM hwspinlock */
+static int
+sweet_smem_alloc(vm_offset_t m, uint32_t part_size, unsigned item, uint32_t size)
+{
+	vm_offset_t lock = ml_io_map(0x01f43000, 0x1000);
+	if (lock == 0) {
+		return -1;
+	}
+	int got = 0;
+	for (int i = 0; i < 100000 && !got; i++) {
+		*(volatile uint32_t *)lock = 1;
+		__asm__ volatile("dsb sy" ::: "memory");
+		got = usb_rd(lock, 0) == 1;
+	}
+	if (!got) {
+		printf("SWEET GLINK: SMEM hwspinlock busy (owner %u)\n", usb_rd(lock, 0));
+		return -1;
+	}
+	int rc = 0;
+	uint32_t free_unc = usb_rd(m, 12), free_cached = usb_rd(m, 16), p = 32;
+	while (p < free_unc) {
+		uint32_t h0 = usb_rd(m, p), sz = usb_rd(m, p + 4), pad = usb_rd(m, p + 8);
+		if ((h0 & 0xffffu) != 0xa5a5u) {
+			rc = -2;
+			break;
+		}
+		if ((h0 >> 16) == item) {
+			rc = 1;                        /* exists */
+			break;
+		}
+		p += 16 + (pad >> 16) + sz;
+	}
+	uint32_t asz = (size + 7u) & ~7u;
+	if (rc == 0 && p + 16 + asz > free_cached) {
+		rc = -3;
+	}
+	if (rc == 0) {
+		*(volatile uint32_t *)(m + p) = 0xa5a5u | (item << 16);
+		*(volatile uint32_t *)(m + p + 4) = asz;
+		*(volatile uint32_t *)(m + p + 8) = asz - size;     /* padding_data, padding_hdr 0 */
+		*(volatile uint32_t *)(m + p + 12) = 0;
+		for (uint32_t k = 0; k < asz; k += 4) {
+			*(volatile uint32_t *)(m + p + 16 + k) = 0;
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+		*(volatile uint32_t *)(m + 12) = p + 16 + asz;        /* offset_free_uncached */
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	*(volatile uint32_t *)lock = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	return rc;
+}
+
+static struct {
+	vm_offset_t desc, tx, rx, ipc;
+	uint32_t txlen, rxlen;
+} sweet_gl;
+
+#define GL_DESC(i) (*(volatile uint32_t *)(sweet_gl.desc + 4 * (i)))
+
+static void
+sweet_glink_kick(void)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	*(volatile uint32_t *)sweet_gl.ipc = 1u << 24;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+sweet_glink_send(uint16_t cmd, uint16_t p1, uint32_t p2)
+{
+	uint32_t head = GL_DESC(1);
+	*(volatile uint32_t *)(sweet_gl.tx + head) = cmd | ((uint32_t)p1 << 16);
+	*(volatile uint32_t *)(sweet_gl.tx + ((head + 4) % sweet_gl.txlen)) = p2;
+	head = (head + 8) % sweet_gl.txlen;
+	__asm__ volatile("dsb sy" ::: "memory");
+	GL_DESC(1) = head;
+	sweet_glink_kick();
+}
+
+static uint32_t
+sweet_glink_rx32(uint32_t off)
+{
+	return usb_rd(sweet_gl.rx, off % sweet_gl.rxlen);
+}
+
+static void
+sweet_glink_adsp(void)
+{
+	const uint32_t part = 0x1cf000, psize = 0x30000;
+	vm_offset_t m = ml_io_map_unmappable(0x86000000 + part, psize, VM_WIMG_IO);
+	sweet_gl.ipc = ml_io_map(0x1799000c, 4);
+	if (m == 0 || sweet_gl.ipc == 0) {
+		return;
+	}
+	int arc = sweet_smem_alloc(m, psize, 479, 0x4000);
+	struct sweet_smem_item d = { 0, 0 }, tx = { 0, 0 }, rx = { 0, 0 };
+	if (sweet_smem_find(m, psize, 478, &d) || sweet_smem_find(m, psize, 479, &tx) ||
+	    sweet_smem_find(m, psize, 480, &rx) || d.size != 32) {
+		printf("SWEET GLINK: items missing (alloc 479 -> %d, desc size %u)\n", arc, d.size);
+		return;
+	}
+	sweet_gl.desc = d.data;
+	sweet_gl.tx = tx.data;
+	sweet_gl.txlen = tx.size;
+	sweet_gl.rx = rx.data;
+	sweet_gl.rxlen = rx.size;
+	GPU_STEP("SWEET GLINK: adsp edge: alloc 479 -> %d, tx fifo %u bytes, rx fifo %u bytes, desc tx %u/%u rx %u/%u\n",
+	    arc, tx.size, rx.size, GL_DESC(0), GL_DESC(1), GL_DESC(2), GL_DESC(3));
+	GL_DESC(2) = 0;                        /* rx tail */
+	GL_DESC(1) = 0;                        /* tx head */
+	sweet_glink_send(0, 1, 1u << 0);       /* VERSION v1, INTENT_REUSE */
+
+	int opens = 0, msgs = 0;
+	for (int t = 0; t < 1000 && msgs < 200; t++) {   /* ~10 s */
+		uint32_t head = GL_DESC(3), tail = GL_DESC(2);
+		if (head == tail) {
+			ud_sleep_ms(10);
+			continue;
+		}
+		uint32_t w0 = sweet_glink_rx32(tail), p2 = sweet_glink_rx32(tail + 4);
+		uint16_t cmd = (uint16_t)w0, p1 = (uint16_t)(w0 >> 16);
+		uint32_t adv = 8;
+		msgs++;
+		switch (cmd) {
+		case 0:                            /* VERSION */
+			printf("SWEET GLINK: rx VERSION %u features 0x%x\n", p1, p2);
+			sweet_glink_send(1, 1, p2 & 1u);
+			break;
+		case 1:                            /* VERSION_ACK */
+			printf("SWEET GLINK: rx VERSION_ACK %u features 0x%x: link up\n", p1, p2);
+			break;
+		case 2: {                          /* OPEN: rcid, name length, name */
+			char name[33];
+			uint32_t len = p2 < 32 ? p2 : 32;
+			for (uint32_t k = 0; k < len; k++) {
+				uint32_t w = sweet_glink_rx32(tail + 8 + (k & ~3u));
+				char c = (char)(w >> (8 * (k & 3u)));
+				name[k] = (c >= 32 && c < 127) ? c : 0;
+			}
+			name[len] = 0;
+			printf("SWEET GLINK: rx OPEN rcid %u \"%s\"\n", p1, name);
+			opens++;
+			adv = (8 + p2 + 7u) & ~7u;
+			break;
+		}
+		case 5:                            /* INTENT: cid, count, count x {size, iid} */
+			adv = (8 + p2 * 8 + 7u) & ~7u;
+			printf("SWEET GLINK: rx INTENT cid %u count %u\n", p1, p2);
+			break;
+		case 9:
+		case 12: {                         /* TX_DATA(_CONT): chunk, left, data */
+			uint32_t chunk = sweet_glink_rx32(tail + 8);
+			adv = (16 + chunk + 7u) & ~7u;
+			printf("SWEET GLINK: rx DATA cid %u chunk %u\n", p1, chunk);
+			break;
+		}
+		default:
+			printf("SWEET GLINK: rx cmd %u p1 %u p2 0x%x\n", cmd, p1, p2);
+			break;
+		}
+		GL_DESC(2) = (tail + adv) % sweet_gl.rxlen;
+	}
+	GPU_STEP("SWEET GLINK: %d messages, %d channels offered by the ADSP; desc tx %u/%u rx %u/%u\n",
+	    msgs, opens, GL_DESC(0), GL_DESC(1), GL_DESC(2), GL_DESC(3));
+}
+
