+/* pdr_interface.c pdr_register_listener: enable 1, service path. */
+static void
+sweet_pdr_register(struct sweet_glch *c, struct sweet_qrtr_st *q)
+{
+	static const char path[] = "msm/adsp/audio_pd";
+	uint8_t b[7 + 4 + 3 + sizeof(path)];
+	uint32_t p = 7, pn = sizeof(path) - 1;
+	b[0] = 0; b[1] = (uint8_t)++q->txn; b[2] = 0; b[3] = 0x20; b[4] = 0;
+	b[p++] = 0x01; b[p++] = 1; b[p++] = 0; b[p++] = 1;          /* enable */
+	b[p++] = 0x02; b[p++] = (uint8_t)pn; b[p++] = 0;
+	bcopy(path, b + p, pn);
+	p += pn;
+	b[5] = (uint8_t)(p - 7); b[6] = 0;
+	if (sweet_qrtr_tx(c, 1, SWEET_PDR_PORT, q->notif_node, q->notif_port, b, p) == 0) {
+		q->registered = 1;
+		printf("SWEET PDR: REGISTER_LISTENER \"%s\" -> %u:0x%x\n", path, q->notif_node, q->notif_port);
+	}
+}
