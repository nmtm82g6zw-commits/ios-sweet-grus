+/* Helper thread i (1..fJobThreads-1) takes the i-th band of panel rows. */
+
+void
+AppleCLCD::bilinearWorker(void *arg, wait_result_t wr __unused)
+{
+	SweetBilinearWorkerArg *wa = (SweetBilinearWorkerArg *)arg;
+	AppleCLCD *fb = wa->fb;
+	uint32_t index = wa->index, seen = 0;  /* workers start before the first job (gen 0) */
+	IOLockLock(fb->fJobLock);
+	for (;;) {
+		while (fb->fJobGen == seen) {
+			IOLockSleep(fb->fJobLock, &fb->fJobGen, THREAD_UNINT);
+		}
+		seen = fb->fJobGen;
+		BilinearJob j = fb->fJob;
+		uint32_t n = fb->fJobThreads, band = (fb->fHeight + n - 1) / n;
+		IOLockUnlock(fb->fJobLock);
+		uint32_t py0 = index * band, py1 = py0 + band;
+		py1 = py1 > fb->fHeight ? fb->fHeight : py1;
+		if (py0 < py1) {
+			fb->bilinearRows(j, py0, py1);
+		}
+		IOLockLock(fb->fJobLock);
+		if (--fb->fJobPending == 0) {
+			IOLockWakeup(fb->fJobLock, &fb->fJobPending, false);
+		}
+	}
+}
+
+/*
+ * Bilinear version of presentScaled: logical pixels outside the layer rect
+ * are clamped to its edge (no bleeding between layers). Band 0 runs here,
+ * the others on the helper threads.
+ */
+void
+AppleCLCD::presentBilinear(SweetSurface *s, const uint8_t *base, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h, uint32_t px0, uint32_t px1)
+{
+	BilinearJob j = { s, base, sx, sy, dx, dy, w, h, px0, px1 };
+	if (fJobThreads <= 1) {
+		bilinearRows(j, 0, fHeight);
+		return;
+	}
+	IOLockLock(fJobLock);
+	fJob = j;
+	fJobPending = fJobThreads - 1;
+	fJobGen++;
+	IOLockWakeup(fJobLock, &fJobGen, false);
+	uint32_t band = (fHeight + fJobThreads - 1) / fJobThreads;
+	IOLockUnlock(fJobLock);
+	bilinearRows(j, 0, band < fHeight ? band : fHeight);
+	IOLockLock(fJobLock);
+	while (fJobPending != 0) {
+		IOLockSleep(fJobLock, &fJobPending, THREAD_UNINT);
+	}
+	IOLockUnlock(fJobLock);
+}
