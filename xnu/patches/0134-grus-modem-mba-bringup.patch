+/*
+ * grus 0134: ARC level vote (Linux rpmhpd): cmd-db slave 3 entry, aux data
+ * = u16 voltage level (vlvl) per hardware level; the vote is the lowest
+ * hlvl whose vlvl >= the requested one. Only cx.lvl / mx.lvl / mss.lvl.
+ */
+int sweet_rpmh_arc_vote(const char *res, unsigned vlvl);
+
+int
+sweet_rpmh_arc_vote(const char *res, unsigned vlvl)
+{
+	if (!res || (strcmp(res, "cx.lvl") && strcmp(res, "mx.lvl") && strcmp(res, "mss.lvl"))) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = rh_poisoned ? EIO : rh_map();
+	uint32_t key[2] = {0, 0}, addr = 0, aux = 0, auxlen = 0;
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	for (unsigned i = 0; !error && i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t auxbase = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (!rh_range(entries, count * RH_DB_ENTRY)) {
+			error = EINVAL;
+			break;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			addr = rh_read(rh_db, e + 16);
+			aux = auxbase + rh_db16(e + 22);
+			auxlen = rh_db16(e + 20);
+			matches += (slave == 3);
+		}
+	}
+	unsigned hlvl = ~0u, n = auxlen / 2;
+	if (!error && (matches != 1 || (addr >> 16) != 3 || !rh_range(aux, auxlen) || n == 0 || n > 16)) {
+		printf("SWEET RPMH: %s: ARC entry not usable (matches %u addr %#x aux %u)\n", res, matches, addr, auxlen);
+		error = ENODEV;
+	}
+	for (unsigned i = 0; !error && i < n; ++i) {
+		if (rh_db16(aux + 2 * i) >= vlvl) {
+			hlvl = i;
+			break;
+		}
+	}
+	if (!error && hlvl == ~0u) {
+		hlvl = n - 1;
+	}
+	if (!error) {
+		printf("SWEET RPMH: %s addr %#x vlvl %u -> hlvl %u (table top %u)\n", res, addr, vlvl, hlvl,
+		    rh_db16(aux + 2 * (n - 1)));
+		uint32_t v = hlvl;
+		error = rh_send_n(&addr, &v, 1);
+	}
+	if (error) {
+		printf("SWEET RPMH: %s vote failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
