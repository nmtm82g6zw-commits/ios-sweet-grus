diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 3cef220..fd934a4 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -676,13 +676,32 @@ sweet_gpu_smmu_map(void)
 	}
 	smmu_wr(cb, 0x0, 0x27);                /* SCTLR: CFRE|AFE|TRE|M */
 	GPU_STEP("SWEET SMMU: CB0 on, enabling stream match for SID 4/5\n");
+	/*
+	 * 0097: SMR0 = valid | mask 1 | ID 4 read back 0 (S2CR0 took the
+	 * write), so the GMU stream stayed unmatched and the first HFI access
+	 * reset the phone (unmatched streams fault, sCR0.USFCFG). Linux
+	 * downstream gives each SID its own SMR with mask 0: SMR0 = SID 5
+	 * (GMU kernel), SMR1 = SID 4 (GMU user), both to context bank 0.
+	 * Unless both read back valid (or sweetgpuforce=1, in case the
+	 * hypervisor reads SMRs as zero), the GMU is not given the memory.
+	 */
 	smmu_wr(s, 0xc00, 0);                  /* S2CR0: translate, CB 0 */
-	smmu_wr(s, 0x800, (1u << 31) | (1u << 16) | 4u);              /* SMR0: SID 4/5 */
+	smmu_wr(s, 0x800, (1u << 31) | 5u);    /* SMR0: SID 5 */
+	smmu_wr(s, 0xc04, 0);                  /* S2CR1: translate, CB 0 */
+	smmu_wr(s, 0x804, (1u << 31) | 4u);    /* SMR1: SID 4 */
 	__asm__ volatile("dsb sy" ::: "memory");
-	GPU_STEP("SWEET SMMU: GMU iova 0x%x -> pa 0x%llx (tables at 0x%llx), CB0 SCTLR 0x%x TCR 0x%x TTBR0 0x%08x%08x SMR0 0x%08x S2CR0 0x%08x tlbsync %s\n",
+	uint32_t smr0 = smmu_rd(s, 0x800), smr1 = smmu_rd(s, 0x804);
+	GPU_STEP("SWEET SMMU: SMR0 0x%08x S2CR0 0x%08x SMR1 0x%08x S2CR1 0x%08x sGFSR 0x%x sCR0 0x%08x\n",
+	    smr0, smmu_rd(s, 0xc00), smr1, smmu_rd(s, 0xc04), smmu_rd(s, 0x48), smmu_rd(s, 0x0));
+	int force = 0;
+	PE_parse_boot_argn("sweetgpuforce", &force, sizeof(force));
+	if (!(smr0 & smr1 & (1u << 31)) && !force) {
+		GPU_STEP("SWEET SMMU: stream match not accepted: GMU memory not handed over (sweetgpuforce=1 overrides)\n");
+		return -1;
+	}
+	GPU_STEP("SWEET SMMU: GMU iova 0x%x -> pa 0x%llx (tables at 0x%llx), CB0 SCTLR 0x%x TCR 0x%x TTBR0 0x%08x%08x tlbsync %s\n",
 	    SWEET_GMU_IOVA, (unsigned long long)pa_d, (unsigned long long)pa_l1, smmu_rd(cb, 0x0),
-	    smmu_rd(cb, 0x30), smmu_rd(cb, 0x24), smmu_rd(cb, 0x20), smmu_rd(s, 0x800),
-	    smmu_rd(s, 0xc00), i < 1000 ? "ok" : "TIMEOUT");
+	    smmu_rd(cb, 0x30), smmu_rd(cb, 0x24), smmu_rd(cb, 0x20), i < 1000 ? "ok" : "TIMEOUT");
 	return 0;
 }
 
