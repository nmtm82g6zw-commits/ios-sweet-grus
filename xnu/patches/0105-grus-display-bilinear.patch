+/*
+ * Bilinear version of presentScaled: logical pixels outside the layer rect
+ * are clamped to its edge (no bleeding between layers).
+ */
+void
+AppleCLCD::presentBilinear(SweetSurface *s, const uint8_t *base, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h, uint32_t px0, uint32_t px1)
+{
+	(void)s;
+	int32_t xmax = dx + w - 1, ymax = dy + h - 1;
+	for (uint32_t py = 0; py < fHeight; py++) {
+		uint32_t ly = fYMap[py];
+		if (ly < (uint32_t)dy || ly >= (uint32_t)(dy + h)) {
+			continue;
+		}
+		int32_t y0 = fY0[py], y1 = y0 + 1;
+		y0 = y0 < dy ? dy : (y0 > ymax ? ymax : y0);
+		y1 = y1 < dy ? dy : (y1 > ymax ? ymax : y1);
+		const uint32_t *r0 = (const uint32_t *)(base + (uint64_t)(sy + y0 - dy) * s->bytesPerRow) + sx - dx;
+		const uint32_t *r1 = (const uint32_t *)(base + (uint64_t)(sy + y1 - dy) * s->bytesPerRow) + sx - dx;
+		uint32_t wy = fYW[py];
+		uint32_t *drow = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes);
+		for (uint32_t px = px0; px < px1; px++) {
+			int32_t x0 = fX0[px], x1 = x0 + 1;
+			x0 = x0 < dx ? dx : (x0 > xmax ? xmax : x0);
+			x1 = x1 < dx ? dx : (x1 > xmax ? xmax : x1);
+			uint32_t wx = fXW[px];
+			uint32_t top = sweet_lerp(r0[x0], r0[x1], wx);
+			uint32_t bot = sweet_lerp(r1[x0], r1[x1], wx);
+			drow[px] = sweet_lerp(top, bot, wy);
+		}
+	}
+}
