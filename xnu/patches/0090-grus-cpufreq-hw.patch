 static void
 sweet_cpufreq_start(void)
 {
 	int on = 1;
 	thread_t thread;
+	sweet_cpufreq_set();
 	PE_parse_boot_argn("sweetcpufreq", &on, sizeof(on));
 	if (on && kernel_thread_start(sweet_cpufreq_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
