+/*
+ * CPU frequency (0089 measured silver 1516 MHz, gold 299 MHz: nothing
+ * selects a performance state, so the gold cluster idles at the 300 MHz
+ * GPLL0 row). Qualcomm cpufreq-hw ("OSM", Linux qcom-cpufreq-hw.c, sdm670
+ * DT freq-domain0 0x17d43000 = cpus 0-5, freq-domain1 0x17d45800 = cpus 6-7):
+ * REG_ENABLE 0x0 bit 0, LUT rows of 32 bytes at 0x110 (bits 31:30 source,
+ * 0 = 300 MHz, else L-value bits 7:0 x 19.2 MHz; bits 18:16 core count,
+ * 1 = single-core turbo row), PERF_STATE 0x920 = LUT index. The hardware
+ * applies voltage (CPR) and thermal limits (LMh) by itself.
+ * Boot-arg sweetcpuperf=N caps the index (default: highest non-turbo row);
+ * sweetcpuperf=-1 leaves ABL's state alone.
+ */
+static void
+sweet_cpufreq_set(void)
+{
+#if defined(SWEET_BOARD_GRUS)
+	static const uint32_t domain_pa[2] = { 0x17d43000u, 0x17d45800u };
+	int cap = 99;
+	PE_parse_boot_argn("sweetcpuperf", &cap, sizeof(cap));
+	if (cap < 0) {
+		printf("SWEET CPUFREQ: left as ABL set it (sweetcpuperf=-1)\n");
+		return;
+	}
+	for (int d = 0; d < 2; d++) {
+		vm_offset_t v = ml_io_map(domain_pa[d], 0x1400);
+		if (v == 0) {
+			continue;
+		}
+		uint32_t en = *(volatile uint32_t *)(v + 0x0);
+		uint32_t cur = *(volatile uint32_t *)(v + 0x920);
+		if (!(en & 1u)) {
+			printf("SWEET CPUFREQ: domain %d not enabled (0x%x); untouched\n", d, en);
+			continue;
+		}
+		char line[200];
+		int len = 0;
+		unsigned prev = 0, best = 0, best_mhz = 0;
+		for (unsigned i = 0; i < 40; i++) {
+			uint32_t row = *(volatile uint32_t *)(v + 0x110 + i * 32);
+			unsigned src = (row >> 30) & 3u, lval = row & 0xffu, cores = (row >> 16) & 7u;
+			unsigned mhz = src ? lval * 192u / 10u : 300u;
+			if (i > 0 && mhz == prev) {
+				break;
+			}
+			prev = mhz;
+			if (len < (int)sizeof(line) - 12) {
+				len += snprintf(line + len, sizeof(line) - (size_t)len, " %u%s", mhz, cores == 1u ? "t" : "");
+			}
+			if (cores != 1u && (int)i <= cap) {
+				best = i;
+				best_mhz = mhz;
+			}
+		}
+		*(volatile uint32_t *)(v + 0x920) = best;
+		__asm__ volatile("dsb sy" ::: "memory");
+		delay(1000);
+		printf("SWEET CPUFREQ: domain %d LUT(MHz):%s; perf state %u -> %u (%u MHz), now %u\n",
+		    d, line, cur, best, best_mhz, *(volatile uint32_t *)(v + 0x920));
+	}
+#endif /* SWEET_BOARD_GRUS: sweet's cpufreq block is not mapped here */
+}
