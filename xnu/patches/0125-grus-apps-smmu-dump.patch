+/*
+ * 0125: read-only dump of the apps SMMU (qcom,qsmmu-v500 = MMU-500 at
+ * 0x15000000, 0x80000; grus DT "qcom,skip-init": the bootloader/hypervisor
+ * owns its setup). Before giving the ADSP a FastRPC buffer (SID 0x1803,
+ * msm_fastrpc_compute_cb9), the audio ION SID 0x1801 or the WLAN SID 0x40,
+ * see how those streams are routed. Plain single-register loads only
+ * (smmu_rd), nothing is written.
+ */
+static void
+sweet_apps_smmu_dump(void)
+{
+	vm_offset_t s = ml_io_map(0x15000000, 0x80000);
+	if (s == 0) {
+		return;
+	}
+	uint32_t cr0 = smmu_rd(s, 0x0), id0 = smmu_rd(s, 0x20), id1 = smmu_rd(s, 0x24);
+	unsigned nsmr = id0 & 0xffu, ncb = id1 & 0xffu;
+	unsigned psz = (id1 >> 31) ? 0x10000u : 0x1000u;
+	unsigned npage = 1u << (((id1 >> 28) & 7u) + 1);
+	int exids = (cr0 >> 3) & 1;
+	printf("SWEET ASMMU: sCR0 0x%08x IDR0 0x%08x IDR1 0x%08x IDR2 0x%08x sGFSR 0x%08x sGFSYNR0 0x%08x; %u SMR %u CB page 0x%x x%u exids %d\n",
+	    cr0, id0, id1, smmu_rd(s, 0x28), smmu_rd(s, 0x48), smmu_rd(s, 0x50), nsmr, ncb, psz, npage, exids);
+	static const struct { uint16_t sid; const char *who; } want[] = {
+		{ 0x1801, "audio ion" }, { 0x1803, "adsprpc cb9" }, { 0x1804, "adsprpc cb10" },
+		{ 0x1805, "adsprpc cb11" }, { 0x1806, "adsprpc cb12" }, { 0x0040, "wlan" },
+		{ 0x0041, "wlan+1" }, { 0x0740, "usb" }, { 0x1826, "slimbus" },
+	};
+	unsigned valid = 0;
+	for (unsigned i = 0; i < nsmr && i < 256; i++) {
+		uint32_t smr = smmu_rd(s, 0x800 + 4 * i), s2cr = smmu_rd(s, 0xc00 + 4 * i);
+		int v = exids ? ((s2cr >> 10) & 1) : (int)(smr >> 31);
+		uint32_t id = smr & 0xffffu, mask = exids ? (smr >> 16) : ((smr >> 16) & 0x7fffu);
+		if (!v) {
+			continue;
+		}
+		valid++;
+		const char *who = "";
+		for (unsigned k = 0; k < sizeof(want) / sizeof(want[0]); k++) {
+			if (((want[k].sid ^ id) & ~mask & 0xffffu) == 0) {
+				who = want[k].who;
+			}
+		}
+		printf("SWEET ASMMU: SMR%u id 0x%04x mask 0x%04x S2CR 0x%08x (type %u cb %u)%s%s\n", i, id, mask,
+		    s2cr, (s2cr >> 16) & 3u, s2cr & 0xffu, *who ? " <- " : "", who);
+	}
+	printf("SWEET ASMMU: %u valid stream match groups\n", valid);
+	for (unsigned k = 0; k < sizeof(want) / sizeof(want[0]); k++) {
+		int hit = 0;
+		for (unsigned i = 0; i < nsmr && i < 256; i++) {
+			uint32_t smr = smmu_rd(s, 0x800 + 4 * i), s2cr = smmu_rd(s, 0xc00 + 4 * i);
+			int v = exids ? ((s2cr >> 10) & 1) : (int)(smr >> 31);
+			uint32_t id = smr & 0xffffu, mask = exids ? (smr >> 16) : ((smr >> 16) & 0x7fffu);
+			if (v && ((want[k].sid ^ id) & ~mask & 0xffffu) == 0) {
+				unsigned cbn = s2cr & 0xffu;
+				hit = 1;
+				if (((s2cr >> 16) & 3u) == 0 && cbn < ncb && (npage + cbn + 1) * psz <= 0x80000) {
+					vm_offset_t cb = s + (npage + cbn) * psz;
+					printf("SWEET ASMMU: sid 0x%04x %s -> CB%u CBAR 0x%08x SCTLR 0x%08x TCR 0x%08x TTBR0 0x%08x%08x FSR 0x%08x\n",
+					    want[k].sid, want[k].who, cbn, smmu_rd(s, 0x1000 + 4 * cbn), smmu_rd(cb, 0x0),
+					    smmu_rd(cb, 0x30), smmu_rd(cb, 0x24), smmu_rd(cb, 0x20), smmu_rd(cb, 0x58));
+				}
+				break;
+			}
+		}
+		if (!hit) {
+			printf("SWEET ASMMU: sid 0x%04x %s: no stream match (unmatched streams %s)\n", want[k].sid,
+			    want[k].who, ((cr0 >> 10) & 1) ? "fault" : "bypass");
+		}
+	}
+}
