@@ -43,6 +44,7 @@ void sweet_usb_probe(void);
 static void sweet_usb_gadget_start(vm_offset_t dwc);
 static void sweet_cpufreq_start(void);
 static void sweet_gpu_cx_on(vm_offset_t gcc, vm_offset_t cc);
+static void sweet_gpu_gmu_boot(vm_offset_t gcc, vm_offset_t cc, vm_offset_t gmu);
 extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 
 #define GCC_PA                  0x00100000
@@ -495,6 +497,174 @@ sweet_gpu_cx_on(vm_offset_t gcc, vm_offset_t cc)
 	printf("SWEET GPU: GMU ITCM[0] 0x%08x write test %s (0x%08x)\n", old,
 	    back == 0x5eed1234u ? "OK" : "FAILED", back);
 #undef GMU_REG
+	int level = 0;
+	PE_parse_boot_argn("sweetgpu", &level, sizeof(level));
+	if (level >= 2 && back == 0x5eed1234u) {
+		sweet_gpu_gmu_boot(gcc, cc, gmu);
+	}
+}
+
+/*
+ * Adreno 616 bring-up, step 3 (sweetgpu=2): boot the GMU firmware, following
+ * Linux a6xx_gmu.c for the a630 family ("legacy" GMU, a615 chip id
+ * 0x06010500 in grus sdm670-gpu.dtsi):
+ *  - gmu_clk_src (RCG 0x1120) to 200 MHz = GPLL0_OUT_MAIN_DIV / 1.5
+ *    (GCC gpu_gpll0_div_clk_src vote 0x52004 bit 16), like the GMU OPP;
+ *  - a6xx_gmu_rpmh_init: RSCC (GMU + 0x23000) handshake + sequencer, PDC
+ *    (0x0b280000) TCS1/TCS3 commands (pdc_address_offset 0x30080, TCS3
+ *    data 3), PDC sequencer (0x0b480000), then a6xx_rpmh_stop;
+ *  - a6xx_gmu_fw_start (cold): GENERAL_7 = 1, a6xx_rpmh_start, firmware
+ *    from ADT /sweet-gpu gmu-fw (tools/adt-add-gpu-fw.py) copied to
+ *    CM3_ITCM_START, BOOT_CONFIG 2, AHB fence range, CM3_CFG 0x4052, chip id
+ *    in HFI_SFR_ADDR, a6xx_gmu_power_config (idle level ACTIVE),
+ *    a6xx_gmu_start: SYSRESET pulse, poll CM3_FW_INIT_RESULT.
+ * Not done yet: HFI queues and the GMU log buffer (need memory mapped in the
+ * GPU SMMU), so HFI_QTBL_INFO and the log address stay 0; the GX rail.
+ */
+static void
+sweet_gpu_gmu_boot(vm_offset_t gcc, vm_offset_t cc, vm_offset_t gmu)
+{
+#define G(x) ((uint32_t)(x) << 2)
+#define GW(r, v) (*(volatile uint32_t *)(gmu + G(r)) = (v))
+#define GR(r) usb_rd(gmu, G(r))
+#define RSC(r) (0x23000u + G(r))
+#define RW(r, v) (*(volatile uint32_t *)(gmu + RSC(r)) = (v))
+#define RR(r) usb_rd(gmu, RSC(r))
+	DTEntry node;
+	void const *fw = NULL;
+	unsigned int fw_size = 0;
+	if (SecureDTLookupEntry(NULL, "/sweet-gpu", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "gmu-fw", &fw, &fw_size) != kSuccess ||
+	    fw_size != 0x8000) {
+		printf("SWEET GPU: no /sweet-gpu gmu-fw in the ADT (size %u): GMU not booted\n", fw_size);
+		return;
+	}
+
+	/* GMU clock: 200 MHz from GPLL0 main/2 (300 MHz) / 1.5. */
+	volatile uint32_t *r = (volatile uint32_t *)(gcc + 0x52004);
+	*r |= 1u << 16;
+	r = (volatile uint32_t *)(gcc + 0x71018);      /* gpu_snoc_dvm_gfx (SMMU) */
+	*r |= 1u;
+	__asm__ volatile("dsb sy" ::: "memory");
+	delay(10);
+	*(volatile uint32_t *)(cc + 0x1124) = (6u << 8) | 2u;   /* src 6, div 1.5 */
+	*(volatile uint32_t *)(cc + 0x1120) |= 1u;              /* CMD_UPDATE */
+	__asm__ volatile("dsb sy" ::: "memory");
+	int ok = sweet_poll_bit(cc, 0x1120, 1u, 0);
+	printf("SWEET GPU: gmu_clk 200 MHz %s: cmd 0x%08x cfg 0x%08x cx_gmu 0x%08x snoc_dvm 0x%08x\n",
+	    ok ? "ok" : "UPDATE TIMEOUT", usb_rd(cc, 0x1120), usb_rd(cc, 0x1124), usb_rd(cc, 0x1098),
+	    usb_rd(gcc, 0x71018));
+
+	/* GPU SMMU (kgsl_smmu 0x05040000) global state, for the next step. */
+	vm_offset_t smmu = ml_io_map(0x05040000, 0x1000);
+	if (smmu) {
+		printf("SWEET GPU: SMMU sCR0 0x%08x sACR 0x%08x IDR0 0x%08x IDR1 0x%08x\n",
+		    usb_rd(smmu, 0x0), usb_rd(smmu, 0x10), usb_rd(smmu, 0x20), usb_rd(smmu, 0x24));
+	}
+
+	vm_offset_t pdc = ml_io_map(0x0b280000, 0x10000);
+	vm_offset_t seq = ml_io_map(0x0b480000, 0x10000);
+	if (pdc == 0 || seq == 0) {
+		return;
+	}
+#define PW(base, r, v) (*(volatile uint32_t *)((base) + G(r)) = (v))
+	/* a6xx_gmu_rpmh_init */
+	RW(0x0004, 1u << 24);                  /* RSC_STATUS0_DRV0: no SDE clock gating */
+	RW(0x000b, 1);                         /* PDC_SLAVE_ID_DRV0 */
+	RW(0x000e, 0); RW(0x000d, 0);          /* HIDDEN_TCS_CMD0 DATA/ADDR */
+	RW(0x000e + 2, 0); RW(0x000d + 2, 0);
+	RW(0x000e + 4, 0x80000000u); RW(0x000d + 4, 0);
+	RW(0x0100, 0);                         /* OVERRIDE_START_ADDR */
+	RW(0x0008, 0x4520);                    /* PDC_SEQ_START_ADDR */
+	RW(0x0009, 0x4510);                    /* PDC_MATCH_VALUE_LO */
+	RW(0x000a, 0x4514);                    /* PDC_MATCH_VALUE_HI */
+	RW(0x0180, 0xa7a506a0u); RW(0x0181, 0xa1e6a6e7u); RW(0x0182, 0xa2e081e1u);
+	RW(0x0183, 0xe9a982e2u); RW(0x0184, 0x0020e8a8u);
+	PW(seq, 0, 0xfebea1e1u); PW(seq, 1, 0xa5a4a3a2u); PW(seq, 2, 0x8382a6e0u);
+	PW(seq, 3, 0xbce3e284u); PW(seq, 4, 0x002081fcu);
+	PW(pdc, 0x1573, 7); PW(pdc, 0x1574, 0); PW(pdc, 0x1572, 0);          /* TCS1 */
+	PW(pdc, 0x1575, 0x10108); PW(pdc, 0x1576, 0x30010); PW(pdc, 0x1577, 1);
+	PW(pdc, 0x1575 + 4, 0x10108); PW(pdc, 0x1576 + 4, 0x30000); PW(pdc, 0x1577 + 4, 0);
+	PW(pdc, 0x1575 + 8, 0x10108); PW(pdc, 0x1576 + 8, 0x30080); PW(pdc, 0x1577 + 8, 0);
+	PW(pdc, 0x15d7, 7); PW(pdc, 0x15d8, 0); PW(pdc, 0x15d6, 0);          /* TCS3 */
+	PW(pdc, 0x15d9, 0x10108); PW(pdc, 0x15da, 0x30010); PW(pdc, 0x15db, 2);
+	PW(pdc, 0x15d9 + 4, 0x10108); PW(pdc, 0x15da + 4, 0x30000); PW(pdc, 0x15db + 4, 3);
+	PW(pdc, 0x15d9 + 8, 0x10108); PW(pdc, 0x15da + 8, 0x30080); PW(pdc, 0x15db + 8, 3);
+	PW(pdc, 0x1148, 0);                    /* PDC_GPU_SEQ_START_ADDR */
+	PW(pdc, 0x1140, 0x80000001u);          /* PDC_GPU_ENABLE_PDC */
+	__asm__ volatile("dsb sy" ::: "memory");
+	/* a6xx_rpmh_stop */
+	GW(0x9307, 1);
+	ok = sweet_poll_bit(gmu, RSC(0x0004), 1u << 16, 1u << 16);
+	GW(0x9307, 0);
+	printf("SWEET GPU: rpmh init done, RSC stop %s (status0 0x%08x)\n", ok ? "ok" : "TIMEOUT", RR(0x0004));
+
+	/* a6xx_gmu_fw_start, cold boot */
+	GW(0x51cc, 1);                         /* GENERAL_7: TCM retention */
+	GW(0x9307, 1u << 1);                   /* RSCC_CONTROL_REQ: wake */
+	ok = sweet_poll_bit(gmu, G(0x9308), 1u << 1, 1u << 1);
+	int ok2 = ok && sweet_poll_bit(gmu, RSC(0x0101), ~0u, 0);
+	GW(0x9307, 0);
+	printf("SWEET GPU: RSC start ack %s seq %s (ack 0x%x busy 0x%x)\n", ok ? "ok" : "TIMEOUT",
+	    ok2 ? "idle" : "BUSY", GR(0x9308), RR(0x0101));
+	if (!ok2) {
+		return;
+	}
+	GW(0x5000, 1);                         /* CM3 held in reset while loading */
+	const uint32_t *w = (const uint32_t *)fw;
+	for (unsigned i = 0; i < 0x8000 / 4; i++) {
+		*(volatile uint32_t *)(gmu + G(0xc00) + i * 4) = w[i];
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	unsigned bad = 0;
+	for (unsigned i = 0; i < 0x8000 / 4; i++) {
+		bad += *(volatile uint32_t *)(gmu + G(0xc00) + i * 4) != w[i];
+	}
+	GW(0x501c, 0);                         /* CM3_FW_INIT_RESULT */
+	GW(0x5001, 2);                         /* CM3_BOOT_CONFIG */
+	GW(0x5185, 0); GW(0x5184, 0);          /* HFI queue table: none yet */
+	GW(0x9311, (1u << 31) | (0xau << 18) | 0xa0u);   /* AHB_FENCE_RANGE_0 */
+	GW(0x502d, 0x4052);                    /* CM3_CFG */
+	GW(0x5182, 0x06015000u);               /* HFI_SFR_ADDR = GMU chip id (a615) */
+	GW(0x5100, 0);                         /* PWR_COL_CP_MSG: no log buffer */
+	GW(0x4c0f, 1); GW(0x4c00, 1); GW(0x4c01, 1);   /* SYS_BUS/ICACHE/DCACHE_CONFIG */
+	GW(0x50c0, 0x9c40400u);                /* PWR_COL_INTER_FRAME_CTRL */
+	GW(0x50e8, GR(0x50e8) | 1u | (1u << 4) | (1u << 8) | (1u << 9) | (1u << 10) | (1u << 11));
+	uint32_t dtcm = GR(0x1c00 + 0xff8), mask, want;
+	if (dtcm <= 0x20010004u) {
+		mask = ~0u; want = 0xbabefaceu;
+	} else {
+		mask = 0x1ffu; want = 0x100u;
+	}
+	printf("SWEET GPU: GMU fw loaded (%u words differ), DTCM ver 0x%08x, starting CM3\n", bad, dtcm);
+	__asm__ volatile("dsb sy" ::: "memory");
+	GW(0x5000, 1);
+	GW(0x5101, 0);                         /* PWR_COL_CP_RESP */
+	GW(0x5000, 0);
+	__asm__ volatile("dsb sy" ::: "memory");
+	uint32_t res = 0;
+	int t;
+	for (t = 0; t < 5000; t++) {           /* up to 500 ms */
+		res = GR(0x501c);
+		if ((res & mask) == want) {
+			break;
+		}
+		delay(100);
+	}
+	printf("SWEET GPU: GMU firmware %s after %d.%d ms: init result 0x%08x (want 0x%x)\n",
+	    (res & mask) == want ? "RUNNING" : "init TIMEOUT", t / 10, t % 10, res, want);
+	printf("SWEET GPU: GMU general0 0x%x hfi_ctrl 0x%x gmu2host 0x%x ao_int 0x%x rpmh_power 0x%x sptprac 0x%x cx_busy 0x%x\n",
+	    GR(0x51c5), GR(0x5180), GR(0x5192), GR(0x9305), GR(0x50ec), GR(0x50d0), GR(0x930c));
+	if ((res & mask) != want) {
+		GW(0x5000, 1);                     /* stop the CM3 again */
+	}
+#undef PW
+#undef G
+#undef GW
+#undef GR
+#undef RSC
+#undef RW
+#undef RR
 }
 
