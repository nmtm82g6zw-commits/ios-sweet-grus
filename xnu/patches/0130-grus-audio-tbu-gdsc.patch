--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -1796,6 +1796,39 @@ sweet_glink_rx32(uint32_t off)
 	return usb_rd(sweet_gl.rx, off % sweet_gl.rxlen);
 }
 
+/*
+ * 0130: k49 froze the whole SoC ~14 s after CREATE_STATIC with no AFE
+ * command and no SMMU fault: the first ADSP DMA through the apps SMMU.
+ * Stream IDs 0x1800-0x1bff go through adsp_tbu@0x150dd000, whose power is
+ * the GCC vote hlos1_vote_aggre_noc_mmu_audio_tbu_gdsc (0x17d030, grus DT
+ * vdd-supply of adsp_tbu) - nobody turned it on, so the transaction to an
+ * unpowered TBU hangs the NoC. Vote it on (clear SW_COLLAPSE) and wait for
+ * PWR_ON, as Linux gdsc.c does for VOTABLE GDSCs.
+ */
+static int
+sweet_audio_tbu_gdsc(void)
+{
+	vm_offset_t g = ml_io_map(0x0017c000, 0x4000);
+	if (!g) {
+		return -1;
+	}
+	uint32_t before = usb_rd(g, 0x1030);
+	*(volatile uint32_t *)(g + 0x1030) = before & ~1u;
+	__asm__ volatile("dsb sy" ::: "memory");
+	uint32_t v = 0;
+	int i;
+	for (i = 0; i < 500; i++) {
+		v = usb_rd(g, 0x1030);
+		if (v & (1u << 31)) {
+			break;
+		}
+		delay(1);
+	}
+	printf("SWEET ADSP: audio TBU GDSC 0x17d030: 0x%08x -> 0x%08x after %d us (%s)\n", before, v, i,
+	    (v & (1u << 31)) ? "PWR_ON" : "no PWR_ON bit");
+	return (v & (1u << 31)) ? 0 : -1;
+}
+
 /*
  * 0126: audio PD static process, like grus Android's "adsprpcd audiopd"
  * (Xiaomi grus-p-oss drivers/char/adsprpc.c, FASTRPC_INIT_CREATE_STATIC):
@@ -3513,6 +3546,9 @@ sweet_adsp_thread(void *arg __unused, wait_result_t wr __unused)
 	sweet_apps_smmu_dump();
 	sweet_smem_list(0x1cf000, 0x30000, "apps<->adsp before");
 	(void)sweet_qmp_send("{class: image, res: load_state, name: adsp, val: on}");
+	if (sweet_audio_tbu_gdsc() != 0) {
+		printf("SWEET ADSP: audio TBU not confirmed powered; continuing (status bit may not exist)\n");
+	}
 	static const uint16_t adsp_sids[] = { 0x1801, 0x1803, 0x1804, 0x1805, 0x1806 };
 	(void)sweet_apps_smmu_identity(adsp_sids, 5, "ADSP audio/FastRPC");
 	sweet_remote_heap();
