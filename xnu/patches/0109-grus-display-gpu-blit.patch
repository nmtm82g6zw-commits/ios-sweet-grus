+/*
+ * GPU display path. The panel stride (4320 bytes) is not a multiple of the
+ * 64 bytes the 2D engine needs for a destination pitch, so:
+ *  1. scale + bilinear filter the iOS surface into an intermediate buffer
+ *     with a 4352-byte pitch (GPU);
+ *  2. copy its even rows to the panel with pitch 2 x 4320 = 8640 (GPU);
+ *  3. copy its odd rows the same way, the destination base moved back by
+ *     4320 mod 64 = 32 bytes to stay 64-byte aligned and the x range moved
+ *     right by 8 pixels to compensate (GPU).
+ * The CPU only cleans the surface's cache lines (the SMMU walks are not
+ * coherent). Any failure falls back to the CPU path for good.
+ */
+bool
+AppleCLCD::gpuMapDescriptor(IOMemoryDescriptor *md, IOByteCount off, IOByteCount len, uint32_t va)
+{
+	IOByteCount start = off & ~(IOByteCount)0xfff, end = (off + len + 0xfff) & ~(IOByteCount)0xfff;
+	uint32_t n = (uint32_t)((end - start) >> 12);
+	if (n == 0 || n > SWEET_G2D_WINDOW >> 12) {
+		return false;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		IOByteCount seg = 0;
+		addr64_t pa = md->getPhysicalSegment(start + ((IOByteCount)i << 12), &seg, kIOMemoryMapperNone);
+		if (pa == 0) {
+			return false;
+		}
+		fPages[i] = pa;
+	}
+	return sweet_gpu_map(va, fPages, n) == 0;
+}
+
+bool
+AppleCLCD::gpuSetup()
+{
+	fGpuInit = true;
+	fPages = (uint64_t *)IOMalloc((SWEET_G2D_WINDOW >> 12) * sizeof(uint64_t));
+	fInterPitch = (fWidth * 4 + 63) & ~63u;
+	fInter = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut,
+	    (vm_size_t)fInterPitch * fHeight, page_size);
+	if (fPages == NULL || fInter == NULL || (fHeight & 1) || ((fRowBytes * 2) & 63) || (fRowBytes & 3)) {
+		IOLog("SWEET FB: GPU path unavailable (memory/geometry)\n");
+		return false;
+	}
+	IOMemoryDescriptor *panel = fSurface->memory;
+	if (!gpuMapDescriptor(panel, 0, (IOByteCount)fRowBytes * fHeight, SWEET_G2D_PANEL_VA) ||
+	    !gpuMapDescriptor(fInter, 0, (IOByteCount)fInterPitch * fHeight, SWEET_G2D_INTER_VA)) {
+		IOLog("SWEET FB: GPU path: mapping failed\n");
+		return false;
+	}
+	IOLog("SWEET FB: GPU path on (intermediate pitch %u, panel stride %u)\n", fInterPitch, fRowBytes);
+	return true;
+}
+
+bool
+AppleCLCD::gpuPresent(SweetSurface *s, uintptr_t src, int32_t sx, int32_t sy, int32_t w, int32_t h)
+{
+	if (fGpuBroken || !sweet_gpu_ready()) {
+		return false;
+	}
+	if (!fGpuInit && !gpuSetup()) {
+		fGpuBroken = true;
+		return false;
+	}
+	if (fInter == NULL || s->memory == NULL || (s->bytesPerRow & 63) || (s->offset & 15) ||
+	    s->elementWidth != 1 || s->elementHeight != 1 || sx < 0 || sy < 0 ||
+	    sx + w > (int32_t)s->width || sy + h > (int32_t)s->height) {
+		return false;
+	}
+	IOByteCount len = (IOByteCount)s->bytesPerRow * s->height;
+	if ((s->offset & 0xfff) + len > SWEET_G2D_WINDOW) {
+		return false;
+	}
+	/* surface slot: reuse a mapping when the surface (memory + first page) is the same */
+	IOByteCount seg = 0;
+	uint64_t pa0 = s->memory->getPhysicalSegment(s->offset & ~(IOByteCount)0xfff, &seg, kIOMemoryMapperNone);
+	int slot = -1, lru = 0;
+	for (int i = 0; i < SWEET_G2D_SLOTS; i++) {
+		if (fSlot[i].mem == s->memory && fSlot[i].id == s->id && fSlot[i].pa0 == pa0) {
+			slot = i;
+		}
+		if (fSlot[i].stamp < fSlot[lru].stamp) {
+			lru = i;
+		}
+	}
+	if (slot < 0) {
+		slot = lru;
+		fSlot[slot].mem = NULL;
+		if (!gpuMapDescriptor(s->memory, s->offset, len, SWEET_G2D_SLOT_VA(slot))) {
+			return false;
+		}
+		fSlot[slot].mem = s->memory;
+		fSlot[slot].id = s->id;
+		fSlot[slot].pa0 = pa0;
+	}
+	fSlot[slot].stamp = ++fSlotClock;
+	CleanPoC_DcacheRegion((vm_offset_t)(src + s->offset), len);
+
+	uint32_t half = fHeight / 2, rem = fRowBytes & 63;
+	struct sweet_blit b[3];
+	bzero(b, sizeof(b));
+	b[0].src_va = SWEET_G2D_SLOT_VA(slot) + (uint32_t)(s->offset & 0xfff);
+	b[0].src_pitch = s->bytesPerRow;
+	b[0].src_w = s->width;
+	b[0].src_h = s->height;
+	b[0].sx0 = sx; b[0].sy0 = sy; b[0].sx1 = sx + w - 1; b[0].sy1 = sy + h - 1;
+	b[0].dst_va = SWEET_G2D_INTER_VA;
+	b[0].dst_pitch = fInterPitch;
+	b[0].dx0 = 0; b[0].dy0 = 0; b[0].dx1 = (int32_t)fWidth - 1; b[0].dy1 = (int32_t)fHeight - 1;
+	b[0].filter = fFilter ? 1 : 0;
+	for (int k = 0; k < 2; k++) {
+		struct sweet_blit *c = &b[1 + k];
+		c->src_va = SWEET_G2D_INTER_VA + (uint32_t)k * fInterPitch;
+		c->src_pitch = fInterPitch * 2;
+		c->src_w = fWidth;
+		c->src_h = half;
+		c->sx0 = 0; c->sy0 = 0; c->sx1 = (int32_t)fWidth - 1; c->sy1 = (int32_t)half - 1;
+		c->dst_va = SWEET_G2D_PANEL_VA + (k ? fRowBytes - rem : 0);
+		c->dst_pitch = fRowBytes * 2;
+		c->dx0 = k ? (int32_t)(rem / 4) : 0;
+		c->dx1 = c->dx0 + (int32_t)fWidth - 1;
+		c->dy0 = 0; c->dy1 = (int32_t)half - 1;
+		c->filter = 0;
+	}
+	if (sweet_gpu_blit(b, 3) != 0) {
+		IOLog("SWEET FB: GPU blit failed, back to the CPU path\n");
+		fGpuBroken = true;
+		return false;
+	}
+	static int logged;
+	if (!logged) {
+		logged = 1;
+		IOLog("SWEET FB: first GPU present: surface %u %ux%u bpr %u slot %d\n", s->id, s->width,
+		    s->height, s->bytesPerRow, slot);
+	}
+	return true;
+}
+
 static inline uint32_t
 sweet_lerp(uint32_t a, uint32_t b, uint32_t w)
 {
