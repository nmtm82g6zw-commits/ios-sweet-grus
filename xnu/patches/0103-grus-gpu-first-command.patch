+
+/*
+ * Adreno 616 bring-up, step 7 (sweetgpu=6): the first command the GPU runs,
+ * following Linux a6xx_gpu.c hw_init / a6xx_cp_init for a615 (no hwcg,
+ * CP protect or UBWC yet: not needed for CP_MEM_WRITE). GPU memory: SIDs
+ * 0/1 to context bank 0 (sweet_gpu_smmu_map), iova 0x60100000:
+ * +0 SQE microcode (a630_sqe.fw minus its first dword, like
+ * adreno_fw_create_bo), +0x8000 ring buffer (4 KiB), +0x9000 target.
+ * Ring: PKT7 CP_ME_INIT (8 dwords), CP_SET_SECURE_MODE 0 (needs the zap
+ * shader), CP_MEM_WRITE 0xc0ffee to +0x9000; each followed by a wait for
+ * CP_RB_RPTR to reach the write pointer.
+ */
+#define GR(r) usb_rd(g, (uint32_t)(r) << 2)
+#define GWR(r, v) (*(volatile uint32_t *)(g + ((uint32_t)(r) << 2)) = (v))
+static uint32_t
+pm4_parity(uint32_t v)
+{
+	return (0x9669u >> (0xfu & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^
+	       (v >> 20) ^ (v >> 24) ^ (v >> 28)))) & 1u;
+}
+
+static uint32_t
+pkt7(uint32_t op, uint32_t cnt)
+{
+	return 0x70000000u | cnt | (pm4_parity(cnt) << 15) | ((op & 0x7fu) << 16) | (pm4_parity(op) << 23);
 }
 
+static int
+sweet_cp_kick(vm_offset_t g, uint32_t wptr, const char *what)
+{
+	FlushPoC_DcacheRegion((vm_offset_t)GPU_DATA, 0x10000);
+	__asm__ volatile("dsb sy" ::: "memory");
+	GWR(0x807, wptr);                      /* CP_RB_WPTR */
+	uint32_t rptr = 0, st = 0;
+	int n;
+	for (n = 0; n < 2000; n++) {           /* up to 200 ms */
+		rptr = GR(0x806);                  /* CP_RB_RPTR */
+		st = GR(0x210);                    /* RBBM_STATUS */
+		if (rptr == wptr && !(st & ~1u)) {    /* idle except CP_AHB_BUSY_CX_MASTER */
+			break;
+		}
+		delay(100);
+	}
+	vm_offset_t cb = ml_io_map(0x05048000, 0x1000);
+	GPU_STEP("SWEET CP: %s: rptr %u/%u RBBM_STATUS 0x%08x INT0 0x%08x HW_FAULT 0x%08x STATUS_1 0x%08x SQE_STAT 0x%x SMMU FSR 0x%x FAR 0x%08x%08x (%d00 us)\n",
+	    what, rptr, wptr, st, GR(0x201), GR(0x821), GR(0x825), GR(0x908),
+	    cb ? smmu_rd(cb, 0x58) : 0, cb ? smmu_rd(cb, 0x64) : 0, cb ? smmu_rd(cb, 0x60) : 0, n);
+	return rptr == wptr ? 0 : -1;
+}
+
+static void
+sweet_gpu_cp_test(vm_offset_t g, vm_offset_t gmu)
+{
+	(void)gmu;
+	DTEntry node;
+	void const *sqe = NULL;
+	unsigned int sqe_size = 0;
+	if (SecureDTLookupEntry(NULL, "/sweet-gpu", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "sqe-fw", &sqe, &sqe_size) != kSuccess ||
+	    sqe_size < 8 || sqe_size - 4 > 0x8000) {
+		printf("SWEET CP: no sqe-fw in the ADT (size %u)\n", sqe_size);
+		return;
+	}
+	uint32_t *ring = (uint32_t *)(GPU_DATA + 0x8000);
+	volatile uint32_t *dst = (volatile uint32_t *)(GPU_DATA + 0x9000);
+	bzero(GPU_DATA, 0x10000);
+	bcopy((const uint8_t *)sqe + 4, GPU_DATA, sqe_size - 4);
+	dst[0] = 0xdeadbeefu;
+	FlushPoC_DcacheRegion((vm_offset_t)GPU_DATA, 0x10000);
+	GPU_STEP("SWEET CP: SQE version 0x%08x 0x%08x (%u bytes), hw_init\n",
+	    ((const uint32_t *)sqe)[0], ((const uint32_t *)sqe)[1], sqe_size);
+
+	/* hw_init (a615: GBIF, no hw_apriv) */
+	GWR(0x3c45, 0); (void)GR(0x3c45);      /* GBIF_HALT */
+	GWR(0x16, 0); (void)GR(0x16);          /* RBBM_GBIF_HALT */
+	GWR(0xf803, 0);                        /* RBBM_SECVID_TSB_CNTL */
+	GWR(0xf800, 0); GWR(0xf801, 0); GWR(0xf802, 0);  /* TSB trusted base/size */
+	static const uint16_t addr_mode[12] = { 0x842, 0xc01, 0x8601, 0x8e05, 0x9e01, 0xbe05,
+	    0xa601, 0x9601, 0xe00, 0xae01, 0xb601, 0xf810 };
+	for (unsigned i = 0; i < 12; i++) {
+		GWR(addr_mode[i], 1);              /* 64-bit addressing */
+	}
+	GWR(0x10, 3);                          /* RBBM_VBIF_CLIENT_QOS_CNTL */
+	GWR(0x50b, 0xffffffffu);               /* RBBM_PERFCTR_GPU_BUSY_MASKED */
+	GWR(0xe05, 0xffffffc0u); GWR(0xe06, 0x0001ffffu);   /* UCHE_WRITE_RANGE_MAX */
+	GWR(0xe09, 0xfffff000u); GWR(0xe0a, 0x0001ffffu);   /* UCHE_TRAP_BASE */
+	GWR(0xe07, 0xfffff000u); GWR(0xe08, 0x0001ffffu);   /* UCHE_WRITE_THRU_BASE */
+	GWR(0xe0b, 0x00100000u); GWR(0xe0c, 0);             /* UCHE_GMEM_RANGE_MIN 1 MiB */
+	GWR(0xe0d, 0x00100000u + 0x80000u - 1); GWR(0xe0e, 0);  /* + 512 KiB GMEM - 1 */
+	GWR(0xe18, 0x804);                     /* UCHE_FILTER_CNTL */
+	GWR(0xe17, 0x4);                       /* UCHE_CACHE_WAYS */
+	GWR(0x8c2, 0x010000c0u);               /* CP_ROQ_THRESHOLDS_2 */
+	GWR(0x8c1, 0x8040362cu);               /* CP_ROQ_THRESHOLDS_1 */
+	GWR(0x8c3, 128);                       /* CP_MEM_POOL_SIZE */
+	GWR(0x9e00, 0x0018000u);               /* PC_DBG_ECO_CNTL: a615 prim fifo threshold */
+	GWR(0x98d, 1);                         /* CP_AHB_CNTL: AHB default slave response ERROR */
+	GWR(0x500, 1);                         /* RBBM_PERFCTR_CNTL */
+	GWR(0x1f, (1u << 30) | 0x1fffffu);     /* RBBM_INTERFACE_HANG_INT_CNTL */
+	GWR(0xe19, (1u << 7) | 1u);            /* UCHE_CLIENT_PF */
+	GWR(0x38, 0);                          /* RBBM_INT_0_MASK: polled, no IRQ */
+
+	GWR(0x830, SWEET_GPU_IOVA); GWR(0x831, 0);          /* CP_SQE_INSTR_BASE */
+	GWR(0x800, SWEET_GPU_IOVA + 0x8000); GWR(0x801, 0); /* CP_RB_BASE */
+	/* MSM_GPU_RB_CNTL_DEFAULT for 4 KiB: BUFSZ log2(4096/8) = 9, BLKSZ log2(32/8) = 2, NO_UPDATE */
+	GWR(0x802, 9u | (2u << 8) | (1u << 27));
+	GWR(0x807, 0);                         /* CP_RB_WPTR */
+	__asm__ volatile("dsb sy" ::: "memory");
+	GWR(0x808, 1);                         /* CP_SQE_CNTL: start the CP */
+	delay(1000);
+	GPU_STEP("SWEET CP: SQE started: RBBM_STATUS 0x%08x HW_FAULT 0x%08x SQE_STAT 0x%x RB_CNTL 0x%x\n",
+	    GR(0x210), GR(0x821), GR(0x908), GR(0x802));
+
+	unsigned w = 0;
+	ring[w++] = pkt7(0x48, 8);             /* CP_ME_INIT */
+	ring[w++] = 0x0000002fu;
+	ring[w++] = 0x00000003u;
+	ring[w++] = 0x20000000u;
+	ring[w++] = 0; ring[w++] = 0; ring[w++] = 0; ring[w++] = 0; ring[w++] = 0;
+	if (sweet_cp_kick(g, w, "CP_ME_INIT")) {
+		return;
+	}
+	ring[w++] = pkt7(0x66, 1);             /* CP_SET_SECURE_MODE */
+	ring[w++] = 0;
+	if (sweet_cp_kick(g, w, "CP_SET_SECURE_MODE 0")) {
+		return;
+	}
+	ring[w++] = pkt7(0x3d, 3);             /* CP_MEM_WRITE */
+	ring[w++] = SWEET_GPU_IOVA + 0x9000;
+	ring[w++] = 0;
+	ring[w++] = 0x00c0ffeeu;
+	(void)sweet_cp_kick(g, w, "CP_MEM_WRITE");
+	FlushPoC_DcacheRegion((vm_offset_t)GPU_DATA + 0x9000, 0x1000);
+	GPU_STEP("SWEET CP: target word 0x%08x -> %s\n", dst[0],
+	    dst[0] == 0x00c0ffeeu ? "THE GPU EXECUTED OUR COMMAND" : "not written");
+}
