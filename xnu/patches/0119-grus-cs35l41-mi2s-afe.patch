+	if (amp_read(0x10, &id)) {
+		return EIO;
+	}
+	const struct sweet_otp_el *map;
+	unsigned n;
+	switch (id) {
+	case 0x01: case 0x08:
+		map = sweet_amp_map_1; n = sizeof(sweet_amp_map_1) / sizeof(map[0]); break;
+	case 0x02: case 0x03: case 0x06:
+		map = sweet_amp_map_2; n = sizeof(sweet_amp_map_2) / sizeof(map[0]); break;
+	default:
+		printf("SWEET AMP: unknown OTPID %#x\n", id);
+		return EINVAL;
+	}
+	for (unsigned i = 0; i < 32; i++) {
+		if (amp_read(0x400 + 4 * i, &mem[i])) {
+			return EIO;
+		}
+	}
+	int bit = 16, word = 2, writes = 0;
+	for (unsigned i = 0; i < n; i++) {
+		uint32_t v = 0;
+		int size = map[i].size;
+		if (bit + size - 1 >= 32) {
+			v = (mem[word] & amp_genmask(31, bit)) >> bit;
+			word++;
+			v |= (word < 32 ? (mem[word] & amp_genmask(bit + size - 33, 0)) : 0) << (32 - bit);
+			bit += size - 32;
+		} else if (bit + size - 1 >= 0 && size > 0) {
+			v = (mem[word] & amp_genmask(bit + size - 1, bit)) >> bit;
+			bit += size;
+		}
+		if (bit == 32) {
+			bit = 0;
+			word++;
+		}
+		if (word >= 32) {
+			printf("SWEET AMP: OTP map overrun at %u\n", i);
+			return EIO;
+		}
+		if (map[i].reg != 0 && size > 0) {
+			if (amp_update(map[i].reg, amp_genmask(map[i].shift + size - 1, map[i].shift),
+			    v << map[i].shift)) {
+				return EIO;
+			}
+			writes++;
+		}
+	}
+	printf("SWEET AMP: OTP id %#x unpacked, %d trims written\n", id, writes);
+	return 0;
+}
+
+static int
+amp_setup(uint32_t revid)
+{
+	uint32_t v = 0;
+	unsigned i;
+	for (i = 0; i < 100; i++) {
+		if (amp_read(0x1001c, &v) == 0 && (v & 2u)) {
+			break;
+		}
+		ud_sleep_ms(1);
+	}
+	uint32_t s3 = 0;
+	(void)amp_read(0x10018, &s3);
+	printf("SWEET AMP: OTP_BOOT_DONE %s (status4 %#x status3 %#x)\n", (v & 2u) ? "yes" : "NO", v, s3);
+	if (!(v & 2u) || (s3 & 0x80000000u)) {
+		return EIO;
+	}
+	if (revid != 0xb0 && revid != 0xb2) {
+		printf("SWEET AMP: revision %#x has no errata table here\n", revid);
+		return ENOTSUP;
+	}
+	static const uint32_t errata[][2] = {
+		{ 0x4100, 0 }, { 0x4310, 0 }, { 0x4400, 0 }, { 0x381c, 0x51 },
+		{ 0x02bc20e0, 0 }, { 0x02bc2020, 0 }, { 0x2018, 0 }, { 0x6c04, 0 },
+		{ 0x4c28, 0 }, { 0x4c2c, 0 },
+	};
+	int err = amp_write(0x40, 0x55) | amp_write(0x40, 0xaa);
+	for (i = 0; !err && i < sizeof(errata) / sizeof(errata[0]); i++) {
+		err = amp_write(errata[i][0], errata[i][1]);
+	}
+	if (!err) {
+		err = amp_write(0x02bc1000, 0);      /* DSP1_CCM_CORE_CTRL */
+	}
+	if (!err) {
+		err = amp_otp_unpack();
+	}
+	err |= amp_write(0x40, 0xcc) | amp_write(0x40, 0x33);
+	if (err) {
+		return EIO;
+	}
+	err |= amp_write(0x10110, 0x7ffcfe3f);       /* IRQ1_MASK1 default */
+	/* Boost: L 1.0 uH -> lbst 0, C 15 uF -> range 0, Ipk 4000 mA -> 0x40. */
+	err |= amp_update(0x3810, 0xffff, 0x24 | (0x24u << 8));
+	err |= amp_update(0x3814, 0xff03, 0x75u << 8);
+	err |= amp_update(0x3808, 0x7f, ((4000 - 1600) / 50) + 0x10);
+	err |= amp_update(0x2018, 0x30, 2u << 4);    /* BST_EN default */
+	/* ASP: I2S, SCLK/LRCLK from the SoC, 16-bit RX slots and words, 48 kHz. */
+	err |= amp_update(0x4808, 0x0711, 2u << 8);
+	err |= amp_update(0x4808, 0xff000000u, 16u << 24);
+	err |= amp_update(0x4840, 0x3f, 16);
+	err |= amp_update(0x2c0c, 0x1f, 0x03);
+	/* PLL reference = SCLK 1.536 MHz (cfg 0x1b), as cs35l41_component_set_sysclk. */
+	err |= amp_update(0x2c04, 0x0800, 0x0800);
+	err |= amp_update(0x2c04, 0x07e0, 0x1bu << 5);
+	err |= amp_update(0x2c04, 0x0010, 0);
+	err |= amp_update(0x2c04, 0x0007, 0);
+	err |= amp_update(0x2c04, 0x0800, 0);
+	err |= amp_update(0x2c04, 0x0010, 0x0010);
+	err |= amp_write(0x2d10, 52 | ((84u << 12) & 0x00fff800u));   /* TST_FS_MON0 */
+	err |= amp_write(0x4c00, 0x08);              /* DAC_PCM1_SRC = ASPRX1 */
+	err |= amp_update(0x6000, 0x3ff8, 0x400u << 3);              /* digital volume: MUTE */
+	err |= amp_update(0x4800, 1u << 16, 1u << 16);               /* ASPRX1 enable */
+	if (err) {
+		printf("SWEET AMP: setup register write failed\n");
+		return EIO;
+	}
+	static const uint32_t show[] = { 0x2018, 0x2c04, 0x2c0c, 0x3808, 0x3810, 0x3814, 0x4800, 0x4808, 0x4840, 0x4c00, 0x6000 };
+	for (i = 0; i < sizeof(show) / sizeof(show[0]); i++) {
+		(void)amp_read(show[i], &v);
+		printf("SWEET AMP:   %#06x = %#010x\n", show[i], v);
+	}
+	return 0;
+}
+
+static void
+amp_status(const char *when)
+{
+	static const uint32_t regs[] = { 0x10010, 0x10014, 0x10018, 0x1001c, 0x10090, 0x10094, 0x10098, 0x1009c, 0x2014, 0x2018, 0x2908 };
+	uint32_t v[11] = { 0 };
+	for (unsigned i = 0; i < 11; i++) {
+		(void)amp_read(regs[i], &v[i]);
+	}
+	printf("SWEET AMP: %s: irq1 %08x %08x %08x %08x raw %08x %08x %08x %08x pwr %x/%x pwrmgt %x%s%s\n",
+	    when, v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8], v[9], v[10],
+	    (v[6] & 2u) ? " PLL-LOCK" : "", (v[0] & 0x80000000u) ? " AMP-SHORT" : "");
+}
+
+/* MI2S pins (grus pri_mi2s*_active): gpio65 SCK, 66 WS, 67 SD0, 68 SD1, function 1. */
+static void
+sweet_amp_pins(void)
+{
+	vm_offset_t n = ml_io_map(0x03940000u, 0x8000);   /* TLMM NORTH, pins 64-71 */
+	if (!n) {
+		return;
+	}
+	for (unsigned p = 65; p <= 68; p++) {
+		uint32_t off = (p - 64) * 0x1000u;
+		uint32_t cfg = amp_rd(n, off);
+		amp_wr(n, off, (cfg & ~0x3ffu) | (1u << 2));
+		printf("SWEET AMP: gpio%u cfg %#x -> %#x\n", p, cfg, amp_rd(n, off));
+	}
+}
+
+static void
+sweet_amp_power(int on)
+{
+	if (!amp_ready) {
+		printf("SWEET AMP: not configured, power %d skipped\n", on);
+		return;
+	}
+	uint32_t v = 0;
+	if (on) {
+		amp_status("before power-up");
+		amp_write(0x40, 0x55); amp_write(0x40, 0xaa);
+		amp_write(0x2084, 0x002f1aa0);
+		amp_write(0x40, 0xcc); amp_write(0x40, 0x33);
+		amp_update(0x2014, 1, 1);                     /* GLOBAL_EN */
+		for (unsigned i = 0; i < 100; i++) {
+			if (amp_read(0x10010, &v) == 0 && (v & 0x01000000u)) {
+				break;
+			}
+			ud_sleep_ms(1);
+		}
+		printf("SWEET AMP: PUP_DONE %s\n", (v & 0x01000000u) ? "yes" : "NO");
+		amp_write(0x10010, 0x01000000u);
+		amp_update(0x2018, 1, 1);                     /* AMP_EN */
+		ud_sleep_ms(100);
+		amp_status("on +100ms");
+		ud_sleep_ms(2000);
+		amp_status("on +2s");
+	} else {
+		amp_update(0x2018, 1, 0);
+		amp_update(0x2014, 1, 0);
+		for (unsigned i = 0; i < 100; i++) {
+			if (amp_read(0x10010, &v) == 0 && (v & 0x00800000u)) {
+				break;
+			}
+			ud_sleep_ms(1);
+		}
+		amp_write(0x10010, 0x00800000u);
+		amp_write(0x40, 0x55); amp_write(0x40, 0xaa);
+		amp_write(0x2084, 0x002f1aa3);
+		amp_write(0x40, 0xcc); amp_write(0x40, 0x33);
+		amp_status("powered down");
+	}
+}
