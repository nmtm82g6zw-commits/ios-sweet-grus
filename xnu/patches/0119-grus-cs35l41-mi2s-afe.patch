+static bool amp_ready;
+
+static int
+amp_write(uint32_t reg, uint32_t val)
+{
+	uint8_t b[8] = { (uint8_t)(reg >> 24), (uint8_t)(reg >> 16), (uint8_t)(reg >> 8), (uint8_t)reg,
+		         (uint8_t)(val >> 24), (uint8_t)(val >> 16), (uint8_t)(val >> 8), (uint8_t)val };
+	int err = amp_msg(b, 8, NULL, 0, false);
+	if (err) {
+		printf("SWEET AMP: write %#x = %#x failed %d\n", reg, val, err);
+	}
+	return err;
+}
+
+static int
+amp_update(uint32_t reg, uint32_t mask, uint32_t val)
+{
+	uint32_t v = 0;
+	int err = amp_read(reg, &v);
+	if (err) {
+		printf("SWEET AMP: read %#x failed %d\n", reg, err);
+		return err;
+	}
+	return amp_write(reg, (v & ~mask) | (val & mask));
+}
+
+static uint32_t
+amp_genmask(int h, int l)
+{
+	if (h < l || h > 31 || l < 0) {
+		return 0;
+	}
+	return (0xffffffffu >> (31 - h)) & (0xffffffffu << l);
+}
