+/*
+ * 0131: k50 panicked in kmem_alloc(io_submap, 0x80000): the apps SMMU was
+ * mapped three times (dump, identity, wait loop) and the 8 MiB io_submap
+ * ran out. Map it once.
+ */
+static vm_offset_t
+sweet_asmmu_va(void)
+{
+	static vm_offset_t va;
+	if (!va) {
+		va = ml_io_map(0x15000000, 0x80000);
+	}
+	return va;
+}
