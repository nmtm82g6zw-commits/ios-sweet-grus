+/*
+ * Brightness bring-up: CoreBrightness does not use the IOMFB selectors on
+ * this platform (0082 saw none while the slider moved). Log what userland
+ * sets as registry properties on the framebuffer or its user client, at
+ * most 200 lines per boot, and accept it.
+ */
+static uint32_t sweet_fb_prop_lines;
+
+static IOReturn
+sweet_fb_log_properties(const char *where, OSObject *properties)
+{
+	if (sweet_fb_prop_lines < 200) {
+		char pname[32];
+		const char *text = "?";
+		OSSerialize *ser = OSSerialize::withCapacity(512);
+		if (ser != NULL && properties != NULL && properties->serialize(ser)) {
+			text = ser->text();
+		}
+		proc_selfname(pname, sizeof(pname));
+		sweet_fb_prop_lines++;
+		IOLog("SWEET FB: %s setProperties on %s %.360s\n", pname, where, text);
+		OSSafeReleaseNULL(ser);
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::setProperties(OSObject *properties)
+{
+	return sweet_fb_log_properties("user client", properties);
+}
+
+IOReturn
+AppleCLCD::setProperties(OSObject *properties)
+{
+	return sweet_fb_log_properties("AppleCLCD", properties);
+}
