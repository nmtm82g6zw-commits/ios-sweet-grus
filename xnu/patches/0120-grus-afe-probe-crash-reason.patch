+/* qcom_q6v5_pas adsp: crash_reason_smem 423 (global heap item). */
+static void
+sweet_adsp_crash_reason(void)
+{
+	const uint32_t size = 0x200000;
+	vm_offset_t m = ml_io_map_unmappable(0x86000000, size, VM_WIMG_IO);
+	if (m == 0) {
+		return;
+	}
+	vm_offset_t toc = m + 64 + 128 + 12 + 423 * 16;
+	uint32_t alloc = usb_rd(toc, 0), off = usb_rd(toc, 4), sz = usb_rd(toc, 8);
+	char str[120];
+	uint32_t k = 0;
+	if (alloc == 1 && off + sz <= size) {
+		for (; k < sizeof(str) - 1 && k < sz; k++) {
+			uint32_t w = usb_rd(m + off, k & ~3u);
+			char c = (char)(w >> (8 * (k & 3u)));
+			if (c == 0) {
+				break;
+			}
+			str[k] = (c >= 32 && c < 127) ? c : '.';
+		}
+	}
+	str[k] = 0;
+	printf("SWEET ADSP: crash reason (smem 423 alloc %u size %u): \"%s\"\n", alloc, sz, str);
+	sweet_io_unmap(m, size);
+}
