+/* qcom_glink_smem tx_write: words at head, wrap, head 8-aligned, then kick */
+static void
+sweet_glink_tx(const uint32_t *w, uint32_t words)
+{
+	uint32_t head = GL_DESC(1);
+	for (uint32_t i = 0; i < words; i++) {
+		*(volatile uint32_t *)(sweet_gl.tx + head) = w[i];
+		head = (head + 4) % sweet_gl.txlen;
+	}
+	head = (head + 7u) & ~7u;
+	head %= sweet_gl.txlen;
+	__asm__ volatile("dsb sy" ::: "memory");
+	GL_DESC(1) = head;
+	sweet_glink_kick();
+}
