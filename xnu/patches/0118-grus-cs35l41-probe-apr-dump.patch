+/*
+ * 0118: speaker amplifier probe. grus dtbo (SDM710 MTP Grus overlay):
+ * cs35l41@40 on qupv3_se7_i2c = /soc/i2c@89c000 (QUP wrapper0 SE7),
+ * pins gpio93/94 function qup7 (mux 3, 2 mA, no bias), reset gpio95
+ * (active low), irq gpio96. Clocks (gcc-sdm845.c, qcom,gcc-sdm670):
+ * wrap0 m-ahb vote 0x5200c BIT(6) halt 0x17004, s-ahb BIT(7) 0x17008,
+ * core/core_2x BIT(8)/BIT(9), SE7 BIT(17) halt 0x17880, RCG 0x17884.
+ * TLMM SOUTH tile = 0x03400000 + 0x900000. CS35L41 uses 32-bit big
+ * endian register addresses and values; DEVID (0x0) = 0x35a40.
+ * GENI programming mirrors sweet_touch.c (Linux i2c-qcom-geni FIFO mode),
+ * but TX may carry up to 8 bytes (address + value).
+ */
+#define AMP_SE_PA     0x0089c000u
+#define AMP_GCC_PA    0x00100000u
+#define AMP_TLMM_PA   0x03d5c000u     /* SOUTH + pin 92 */
+#define AMP_TLMM_PIN0 92u
+#define AMP_RCG       0x17884u
+#define AMP_ADDR      0x40u
+#define AMP_RST_PIN   95u
+#define AMP_IRQ_PIN   96u
+
+static struct {
+	vm_offset_t se, gcc, gpio;
+	uint32_t sent, got;
+} amp;
+
+static uint32_t
+amp_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+amp_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+amp_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(amp_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+amp_gpio(unsigned pin, unsigned mux, bool out, bool high)
+{
+	uint32_t off = (pin - AMP_TLMM_PIN0) * 0x1000u;
+	if (out) {
+		amp_wr(amp.gpio, off + 4, (amp_rd(amp.gpio, off + 4) & ~2u) | (high ? 2u : 0u));
+	}
+	uint32_t cfg = amp_rd(amp.gpio, off) & ~0x3ffu;
+	cfg |= (mux << 2) | (out ? 0x200u : 0u);   /* no pull, 2 mA */
+	amp_wr(amp.gpio, off, cfg);
+}
+
+static bool
+amp_clocks(void)
+{
+	uint32_t mask = (0x0fu << 6) | (1u << 17);
+	amp_wr(amp.gcc, 0x5200c, amp_rd(amp.gcc, 0x5200c) | mask);
+	uint32_t cfg = amp_rd(amp.gcc, AMP_RCG + 4u), dfs = amp_rd(amp.gcc, AMP_RCG + 0x14u);
+	printf("SWEET AMP: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    amp_rd(amp.gcc, 0x5200c), amp_rd(amp.gcc, AMP_RCG), cfg, dfs);
+	if (dfs & 1u) {
+		cfg = amp_rd(amp.gcc, AMP_RCG + 0x1cu);
+		if ((cfg & 0x371fu) != 1u) {
+			printf("SWEET AMP: DFS level0=%#x is not XO/1\n", cfg);
+			return false;
+		}
+	} else {
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;   /* XO, div 1: 19.2 MHz */
+		amp_wr(amp.gcc, AMP_RCG + 4u, cfg);
+		amp_wr(amp.gcc, AMP_RCG, amp_rd(amp.gcc, AMP_RCG) | 1u);
+		if (!amp_wait_clear(amp.gcc, AMP_RCG, 1u)) {
+			printf("SWEET AMP: RCG update timeout\n");
+			return false;
+		}
+	}
+	static const uint32_t br[] = { 0x17004, 0x17008, 0x1700c, 0x17010, 0x17014, 0x17880 };
+	bool ok = true;
+	for (unsigned i = 0; i < sizeof(br) / sizeof(br[0]); ++i) {
+		bool on = amp_wait_clear(amp.gcc, br[i], 1u << 31);
+		printf("SWEET AMP: branch %#x = %#x%s\n", br[i], amp_rd(amp.gcc, br[i]), on ? "" : " (halted)");
+		if (!on && (i < 2 || i == 5)) {
+			ok = false;
+		}
+	}
+	return ok;
+}
+
+static bool
+amp_se_init(void)
+{
+	vm_offset_t se = amp.se;
+	uint32_t fw = amp_rd(se, 0x68), tx = amp_rd(se, 0xe24), rx = amp_rd(se, 0xe28);
+	printf("SWEET AMP: se7 fw=%#x proto=%u status=%#x tx=%#x rx=%#x\n",
+	    fw, (fw >> 8) & 0xffu, amp_rd(se, 0x40), tx, rx);
+	if (((fw >> 8) & 0xffu) != 3u || ((tx >> 24) & 0x3fu) != 32u ||
+	    ((rx >> 24) & 0x3fu) != 32u || ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		printf("SWEET AMP: SE7 has no I2C firmware / 32-bit FIFOs\n");
+		return false;
+	}
+	if (amp_rd(se, 0x40) & 0x1001u) {
+		printf("SWEET AMP: SE7 busy\n");
+		return false;
+	}
+	amp_wr(se, 0xe18, 0);
+	amp_wr(se, 0xe1c, 0);
+	amp_wr(se, 0x644, 0);
+	amp_wr(se, 0x618, 0xffffffffu);
+	amp_wr(se, 0x648, 0xffffffffu);
+	amp_wr(se, 0x258, 0);
+	amp_wr(se, 0x28, amp_rd(se, 0x28) | 0x7fu);
+	amp_wr(se, 0xe30, amp_rd(se, 0xe30) | 0x0fu);
+	amp_wr(se, 0x24, 0x7f);
+	amp_wr(se, 0x20, 1);
+	amp_wr(se, 0x7c, 0);
+	amp_wr(se, 0x48, (7u << 4) | 1u);
+	amp_wr(se, 0x278, (10u << 20) | (11u << 10) | 26u);   /* 100 kHz */
+	amp_wr(se, 0x254, 0);
+	amp_wr(se, 0x260, 0x0007f8feu);
+	amp_wr(se, 0x264, 0x000ffefeu);
+	amp_wr(se, 0x284, 0x0007f8feu);
+	amp_wr(se, 0x288, 0x000ffefeu);
+	amp_wr(se, 0x80c, 0);
+	amp_wr(se, 0x810, 0);
+	amp_wr(se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	amp_wr(se, 0x614, 0x3fu | (1u << 9) | (1u << 10) | (1u << 12) | (1u << 13) |
+	    (3u << 24) | (3u << 26) | (3u << 28) | (1u << 30));
+	return (amp_rd(se, 0x804) & 0x1ffffffu) == 0 && (amp_rd(se, 0x800) & 0xfffffffu) == 0;
+}
+
+static void
+amp_abort(void)
+{
+	amp_wr(amp.se, 0x604, 2);
+	for (unsigned i = 0; i < 5000 && !(amp_rd(amp.se, 0x610) & (1u << 5)); ++i) {
+		delay(1);
+	}
+	for (unsigned i = 0; i < 64 && (amp_rd(amp.se, 0x804) & 0x1ffffffu); ++i) {
+		(void)amp_rd(amp.se, 0x780);
+	}
+	amp_wr(amp.se, 0x618, 0xffffffffu);
+}
+
+/* One FIFO message: TX <= 8 bytes or RX <= 16 bytes. */
+static int
+amp_msg(const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr, bool stretch)
+{
+	const uint32_t errs = 0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | (1u << 13) |
+	    (3u << 24) | (3u << 28);
+	vm_offset_t se = amp.se;
+	if (nt > 8 || nr > 16 || (nt && nr) || (!nt && !nr)) {
+		return EINVAL;
+	}
+	if (!amp_wait_clear(se, 0x40, 1u)) {
+		return EBUSY;
+	}
+	amp.sent = amp.got = 0;
+	amp_wr(se, 0x618, 0xffffffffu);
+	amp_wr(se, 0x80c, nt ? 1u : 0u);
+	amp_wr(se, nr ? 0x270 : 0x26c, nr ? nr : nt);
+	amp_wr(se, 0x600, ((nr ? 2u : 1u) << 27) | ((uint32_t)AMP_ADDR << 9) | (stretch ? 4u : 0u));
+	uint32_t irq = 0;
+	for (unsigned i = 0; i < 20000; ++i) {
+		irq = amp_rd(se, 0x610);
+		if (irq & errs) {
+			for (unsigned j = 0; j < 5000 && !(irq & 1u); ++j) {
+				delay(1);
+				irq = amp_rd(se, 0x610);
+			}
+			int err = (irq & (1u << 10)) ? ENXIO : EIO;
+			if ((irq & 1u) && !(amp_rd(se, 0x40) & 1u)) {
+				amp_wr(se, 0x618, irq);
+				return err;
+			}
+			amp_abort();
+			return err;
+		}
+		if (nt && !amp.sent && (irq & (1u << 30))) {
+			for (unsigned w = 0; w < nt; w += 4) {
+				uint32_t word = 0;
+				for (unsigned j = 0; j < 4 && w + j < nt; ++j) {
+					word |= (uint32_t)tx[w + j] << (8u * j);
+				}
+				amp_wr(se, 0x700, word);
+			}
+			amp.sent = nt;
+			amp_wr(se, 0x80c, 0);
+		}
+		uint32_t count = amp_rd(se, 0x804) & 0x1ffffffu;
+		while (count-- && amp.got < nr) {
+			uint32_t word = amp_rd(se, 0x780);
+			for (unsigned j = 0; j < 4 && amp.got < nr; ++j) {
+				rx[amp.got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		if (irq & 1u) {
+			amp_wr(se, 0x618, irq);
+			return (amp.got == nr && amp.sent == nt) ? 0 : EIO;
+		}
+		amp_wr(se, 0x618, irq & ((3u << 26) | (1u << 30)));
+		delay(1);
+	}
+	printf("SWEET AMP: timeout irq=%#x status=%#x\n", irq, amp_rd(se, 0x40));
+	amp_abort();
+	return ETIMEDOUT;
+}
+
+static int
+amp_read(uint32_t reg, uint32_t *val)
+{
+	uint8_t a[4] = { (uint8_t)(reg >> 24), (uint8_t)(reg >> 16), (uint8_t)(reg >> 8), (uint8_t)reg };
+	uint8_t b[4] = { 0 };
+	int err = amp_msg(a, 4, NULL, 0, true);
+	if (!err) {
+		err = amp_msg(NULL, 0, b, 4, false);
+	}
+	*val = ((uint32_t)b[0] << 24) | ((uint32_t)b[1] << 16) | ((uint32_t)b[2] << 8) | b[3];
+	return err;
+}
+
+static void
+sweet_amp_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	ud_sleep_ms(50000);
+	printf("SWEET AMP: probe starting\n");
+	amp.se = ml_io_map(AMP_SE_PA, 0x4000);
+	amp.gcc = ml_io_map(AMP_GCC_PA, 0x60000);
+	amp.gpio = ml_io_map(AMP_TLMM_PA, 0x8000);
+	if (!amp.se || !amp.gcc || !amp.gpio) {
+		printf("SWEET AMP: map failed\n");
+		goto out;
+	}
+	for (unsigned p = 93; p <= 96; p++) {
+		uint32_t off = (p - AMP_TLMM_PIN0) * 0x1000u;
+		printf("SWEET AMP: gpio%u cfg=%#x io=%#x\n", p, amp_rd(amp.gpio, off), amp_rd(amp.gpio, off + 4));
+	}
+	if (!amp_clocks()) {
+		goto out;
+	}
+	amp_gpio(93, 3, false, false);
+	amp_gpio(94, 3, false, false);
+	amp_gpio(AMP_IRQ_PIN, 0, false, false);
+	if (!amp_se_init()) {
+		goto out;
+	}
+	/* Reset pulse: low 2 ms, high, then >= 1.5 ms before control-port access. */
+	amp_gpio(AMP_RST_PIN, 0, true, false);
+	ud_sleep_ms(2);
+	amp_gpio(AMP_RST_PIN, 0, true, true);
+	ud_sleep_ms(10);
+	static const struct { uint32_t reg; const char *name; } regs[] = {
+		{ 0x00000000, "DEVID (expect 0x35a40)" },
+		{ 0x00000004, "REVID" },
+		{ 0x00000008, "FABID" },
+		{ 0x00000010, "OTPID" },
+		{ 0x00002014, "PWR_CTRL1" },
+		{ 0x00010010, "IRQ1_STATUS1" },
+	};
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); ++i) {
+		uint32_t v = 0;
+		int err = amp_read(regs[i].reg, &v);
+		printf("SWEET AMP: reg %#010x %s = %#x err %d\n", regs[i].reg, regs[i].name, v, err);
+		if (err == ENXIO && i == 0) {
+			printf("SWEET AMP: no ACK at 0x%x\n", AMP_ADDR);
+			break;
+		}
+	}
+	printf("SWEET AMP: irq gpio96 level %u\n",
+	    (amp_rd(amp.gpio, (AMP_IRQ_PIN - AMP_TLMM_PIN0) * 0x1000u + 4) & 1u));
+out:
+	printf("SWEET AMP: done\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
