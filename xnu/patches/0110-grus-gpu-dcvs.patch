+/*
+ * GPU clock (0110: the 2D path took 66 ms a frame, the GPU still at its
+ * boot clock). Legacy GMU DCVS as Linux a6xx_gmu_set_freq: DCVS_ACK_OPTION
+ * 0, DCVS_PERF_SETTING (3 << 28) | perf index into the HFI perf table
+ * (0 off, 1 180, 2 267, 3 355, 4 430 MHz), DCVS_BW_SETTING 0xff (firmware
+ * picks the bus vote), OOB DCVS_SET (set 23 / ack 31), then DCVS_RETURN.
+ * Boot-arg sweetgpufreq=N picks the index (default 4).
+ */
+static void
+sweet_gpu_set_freq(vm_offset_t gmu)
+{
+	int idx = 4;
+	PE_parse_boot_argn("sweetgpufreq", &idx, sizeof(idx));
+	idx = idx < 1 ? 1 : (idx > 4 ? 4 : idx);
+	vm_offset_t cc = ml_io_map(0x05090000, 0x9000);
+	uint32_t before = cc ? usb_rd(cc, 0x1020) : 0;        /* gx_gfx3d RCG CFG */
+	*(volatile uint32_t *)(gmu + (0x23fcu << 2)) = 0;                      /* DCVS_ACK_OPTION */
+	*(volatile uint32_t *)(gmu + (0x23fdu << 2)) = (3u << 28) | (uint32_t)idx;   /* DCVS_PERF_SETTING */
+	*(volatile uint32_t *)(gmu + (0x23feu << 2)) = 0xffu;                  /* DCVS_BW_SETTING */
+	int ok = sweet_gmu_oob(gmu, 23, 31, "DCVS_SET") == 0;
+	*(volatile uint32_t *)(gmu + (0x5194u << 2)) = 1u << 31;              /* clear DCVS_SET */
+	GPU_STEP("SWEET GPU: DCVS to perf index %d (%u MHz) %s: DCVS_RETURN %d, gfx3d RCG cfg 0x%08x -> 0x%08x cmd 0x%08x\n",
+	    idx, sweet_gpu_khz[idx] / 1000, ok ? "acked" : "NOT acked",
+	    (int)usb_rd(gmu, 0x23ffu << 2), before, cc ? usb_rd(cc, 0x1020) : 0, cc ? usb_rd(cc, 0x101c) : 0);
+}
